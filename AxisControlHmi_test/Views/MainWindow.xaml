<Window x:Class="AxisControlHmi_test.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        MinWidth="1100"
        MinHeight="700"
        Background="#0B1120"
        Foreground="#E2E8F0"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#111C31" />
            <Setter Property="BorderBrush" Value="#24324A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#334155" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="8" Height="30" Background="#3B82F6" CornerRadius="4" Margin="0,0,13,0" />
                <StackPanel>
                    <TextBlock Text="AXIS CONTROL" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="单轴运动控制与状态监控" FontSize="12" Foreground="#64748B" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Ellipse Width="10" Height="10" Fill="{Binding AxisStateColor}" Margin="0,6,8,0" />
                <TextBlock Text="{Binding AxisStateText}" FontWeight="SemiBold" Foreground="{Binding AxisStateColor}" />
            </StackPanel>
        </Grid>

        <!-- 第二象限：实时参数（左上） -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,8,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="实时参数" Style="{StaticResource SectionTitleStyle}" />
                <UniformGrid Grid.Row="1" Columns="4" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="8" Padding="18" Margin="0,0,8,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="实时位置" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ActualPosition, StringFormat={}{0:F3}}" FontSize="34" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,16,0,8" />
                            <TextBlock Text="mm" Foreground="#64748B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" CornerRadius="8" Padding="18" Margin="4,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="实时速度" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ActualVelocity, StringFormat={}{0:F3}}" FontSize="34" FontWeight="SemiBold" Foreground="#A78BFA" HorizontalAlignment="Center" Margin="0,16,0,8" />
                            <TextBlock Text="mm/s" Foreground="#64748B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="实时转速" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ActualRpm, StringFormat={}{0:F1}}" FontSize="34" FontWeight="SemiBold" Foreground="#FBBF24" HorizontalAlignment="Center" Margin="0,16,0,8" />
                            <TextBlock Text="rpm" Foreground="#64748B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PLC 心跳" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                            <Ellipse Width="42" Height="42" Fill="{Binding HeartbeatLampColor}"
                                     Stroke="#334155" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,13,0,10" />
                            <TextBlock Text="{Binding HeartbeatStatusText}" Foreground="#94A3B8" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- 第一象限：动作日志（右上） -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="8,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="执行日志" Style="{StaticResource SectionTitleStyle}" />
                    <Button Content="清空" Command="{Binding ClearLogCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="14,4" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="#0F172A" Foreground="#CBD5E1" RowBackground="#0F172A"
                          AlternatingRowBackground="#111C31" HorizontalGridLinesBrush="#24324A"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#18243A" />
                            <Setter Property="Foreground" Value="#94A3B8" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="10" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Foreground" Value="#CBD5E1" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="92" />
                        <DataGridTextColumn Header="类型" Binding="{Binding Level}" Width="65" />
                        <DataGridTextColumn Header="动作与结果" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 第三象限：运动控制（左下） -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,8,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="运动控制" Style="{StaticResource SectionTitleStyle}" />

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="相对距离" Style="{StaticResource CaptionStyle}" />
                    <TextBox Grid.Column="1" Text="{Binding RelativeDistance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" />
                    <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource CaptionStyle}" Margin="12,0" />
                    <Button Grid.Column="3" Content="相对运动" Command="{Binding MoveRelativeCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="绝对位置" Style="{StaticResource CaptionStyle}" />
                    <TextBox Grid.Column="1" Text="{Binding AbsolutePosition, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" />
                    <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource CaptionStyle}" Margin="12,0" />
                    <Button Grid.Column="3" Content="绝对运动" Command="{Binding MoveAbsoluteCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <UniformGrid Grid.Row="3" Columns="2" Rows="1" Margin="0,8,0,0">
                    <Button Content="点动反向"
                            ToolTip="按住负向点动，松开或移出按钮立即停止"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="64"
                            Margin="0,0,6,0"
                            PreviewMouseLeftButtonDown="JogNegative_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="JogNegative_PreviewMouseLeftButtonUp"
                            MouseLeave="JogNegative_MouseLeave"
                            LostMouseCapture="JogNegative_LostMouseCapture" />
                    <Button Content="点动正向"
                            ToolTip="按住正向点动，松开或移出按钮立即停止"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="64"
                            Margin="6,0,0,0"
                            PreviewMouseLeftButtonDown="JogPositive_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="JogPositive_PreviewMouseLeftButtonUp"
                            MouseLeave="JogPositive_MouseLeave"
                            LostMouseCapture="JogPositive_LostMouseCapture" />
                </UniformGrid>
            </Grid>
        </Border>

        <!-- 第四象限：轴操作（右下） -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="8,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="轴操作" Style="{StaticResource SectionTitleStyle}" />
                <UniformGrid Grid.Row="1" Columns="2" Rows="2" VerticalAlignment="Center">
                    <Button Command="{Binding ConnectionToggleCommand}" Height="86" Margin="0,0,6,6" Background="{Binding ConnectionButtonColor}" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ConnectionButtonIcon}" FontSize="23" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionButtonText}" FontSize="15" Margin="0,5,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EnableToggleCommand}" Height="86" Margin="6,0,0,6" Background="{Binding EnableButtonColor}" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding EnableButtonIcon}" FontSize="23" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EnableButtonText}" FontSize="15" Margin="0,5,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ResetCommand}" Height="86" Margin="0,6,6,0" Background="#D97706" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="↻" FontSize="25" HorizontalAlignment="Center" />
                            <TextBlock Text="复位" FontSize="15" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}" Height="86" Margin="6,6,0,0" Style="{StaticResource DangerButtonStyle}">
                        <StackPanel>
                            <TextBlock Text="■" FontSize="21" HorizontalAlignment="Center" />
                            <TextBlock Text="停止" FontSize="15" Margin="0,7,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
