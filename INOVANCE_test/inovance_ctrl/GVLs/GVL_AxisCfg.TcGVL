<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_AxisCfg" Id="{a6d00482-ed77-4e7c-afd5-a3584dcb6ace}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // 普通定位运动参数：由 PLC 底层控制，不开放给 HMI
    fMoveVelocity : LREAL := 60.0;
    fMoveAcc      : LREAL := 1000.0;
    fMoveDec      : LREAL := 1000.0;

    // 点动运动参数：由 PLC 底层控制，不开放给 HMI
    fJogVelocity  : LREAL := 60.0;
    fJogAcc       : LREAL := 500.0;
    fJogDec       : LREAL := 500.0;

    // 转速换算参数：若 60 mm = 1 rev，则 60 mm/s ≈ 60 rpm
    fMmPerRev     : LREAL := 60.0;

    // HMI 目标参数限幅
    fMaxRelDistance : LREAL := 6000.0;
    fMinRelDistance : LREAL := -6000.0;

    fMaxAbsPosition : LREAL := 6000.0;
    fMinAbsPosition : LREAL := -6000.0;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>