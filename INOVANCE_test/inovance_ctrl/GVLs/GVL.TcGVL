<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL" Id="{3063c373-a5be-4cc4-8e9a-826008442a45}">
    <Declaration><![CDATA[VAR_GLOBAL
	//伺服控制
    bEnable    : BOOL := FALSE;
    bReset     : BOOL := FALSE;
    bStop      : BOOL := FALSE;
	
	// 运动命令
    bMoveRel : BOOL := FALSE;//相对运动
    bMoveAbs : BOOL := FALSE;//绝对运动
	
	//运动参数
	fTargetPosition : LREAL := 0.0;
    fDistance  : LREAL := 60.0;
    fVelocity  : LREAL := 60.0;
    fAcc       : LREAL := 100.0;
    fDec       : LREAL := 100.0;
	
	//Power状态
	bPowerStatus  : BOOL;//Power状态
    bPowerError   : BOOL;//Power错误
    nPowerErrorID : UDINT;//Power错误码

	//Reset状态
	bResetDone    : BOOL;
	bResetBusy    : BOOL;
	bResetError   : BOOL;
	nResetErrorID : UDINT;

	//相对运动状态
    bMoveRelDone     : BOOL;//相对运动结束
    bMoveRelBusy     : BOOL;//相对运动进行中
	bMoveRelExec     : BOOL;
    bMoveRelError    : BOOL;//相对运动错误
    nMoveRelErrorID  : UDINT;//相对运动错误码
	
	
	//绝对运动状态
	bMoveAbsDone 	: BOOL;
	bMoveAbsBusy 	: BOOL;
	bMoveAbsExec 	: BOOL;
	bMoveAbsError 	: BOOL;
	nMoveAbsErrorID : UDINT;
	
	//停止状态
	bStopDone     : BOOL;
    bStopBusy     : BOOL;
    bStopError    : BOOL;
    nStopErrorID  : UDINT;

	// 轴实时状态
	fActPos       : LREAL;   // 实际位置
	fSetPos       : LREAL;   // 设定位置
	fActVelo      : LREAL;   // 实际速度，单位 mm/s
	fActRpm       : LREAL;   // 实际转速，单位 rpm
	fPosDiff      : LREAL;   // 位置偏差
	bAxisBusy     : BOOL;
	bAxisError    : BOOL;
	nAxisErrorID  : UDINT;
	
	// 换算参数
	fMmPerRev     : LREAL := 60.0;
	
	// 点动命令
	bJogPos : BOOL := FALSE;   // 正向点动，按住为TRUE
	bJogNeg : BOOL := FALSE;   // 反向点动，按住为TRUE
	
	// 点动参数
	fJogVelocity : LREAL := 60.0;     // 点动速度
	fJogAcc      : LREAL := 300.0;    // 点动加速度
	fJogDec      : LREAL := 300.0;    // 点动减速度
	
	// 点动状态
	bJogInVelocity      : BOOL;
	bJogBusy            : BOOL;
	bJogActive          : BOOL;
	bJogCommandAborted  : BOOL;
	bJogError           : BOOL;
	nJogErrorID         : UDINT;
	
	// 点动减速停止状态
	bJogHaltDone        : BOOL;
	bJogHaltBusy        : BOOL;
	bJogHaltActive      : BOOL;
	bJogHaltError       : BOOL;
	nJogHaltErrorID     : UDINT;
		
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>