<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{32a8ea57-4648-49e2-8733-8be1bcee4e26}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    Axis_1 : AXIS_REF;   // 在 TwinCAT 中与 NC 轴链接

    fbPower   : MC_Power;
    fbReset   : MC_Reset;
    fbMoveRel : MC_MoveRelative;
    fbMoveAbs : MC_MoveAbsolute;
    fbJogVel  : MC_MoveVelocity;
    fbJogHalt : MC_Halt;
    fbStop    : MC_Stop;

    trigReset      : R_TRIG;
    trigMoveRel    : R_TRIG;
    trigMoveAbs    : R_TRIG;
    trigJogRelease : F_TRIG;

    bBusyForNewCmd : BOOL;
    bBusyForJog    : BOOL;
    bErrorForCmd   : BOOL;

    bMoveRelExec   : BOOL;
    bMoveAbsExec   : BOOL;

    bJogExecute    : BOOL;
    bJogHaltReq    : BOOL;
    eJogDir        : MC_Direction := MC_Positive_Direction;

    fRelDistanceChecked : LREAL;
    fAbsPositionChecked : LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =====================================================
// 1. 命令触发器
// =====================================================
trigReset(CLK := GVL_HMI.AxisCmd.bReset);
trigMoveRel(CLK := GVL_HMI.AxisCmd.bMoveRel);
trigMoveAbs(CLK := GVL_HMI.AxisCmd.bMoveAbs);

// =====================================================
// 2. HMI 目标参数限幅
// =====================================================
fRelDistanceChecked := GVL_HMI.AxisSet.fRelDistance;
IF fRelDistanceChecked > GVL_AxisCfg.fMaxRelDistance THEN
    fRelDistanceChecked := GVL_AxisCfg.fMaxRelDistance;
ELSIF fRelDistanceChecked < GVL_AxisCfg.fMinRelDistance THEN
    fRelDistanceChecked := GVL_AxisCfg.fMinRelDistance;
END_IF;

fAbsPositionChecked := GVL_HMI.AxisSet.fAbsPosition;
IF fAbsPositionChecked > GVL_AxisCfg.fMaxAbsPosition THEN
    fAbsPositionChecked := GVL_AxisCfg.fMaxAbsPosition;
ELSIF fAbsPositionChecked < GVL_AxisCfg.fMinAbsPosition THEN
    fAbsPositionChecked := GVL_AxisCfg.fMinAbsPosition;
END_IF;

// =====================================================
// 3. Reset 与 Power
// =====================================================
fbReset(
    Axis    := Axis_1,
    Execute := trigReset.Q,
    Done    => GVL_AxisInternal.Axis1.bResetDone,
    Busy    => GVL_AxisInternal.Axis1.bResetBusy,
    Error   => GVL_AxisInternal.Axis1.bResetError,
    ErrorID => GVL_AxisInternal.Axis1.nResetErrorID
);

IF trigReset.Q THEN
    GVL_HMI.AxisCmd.bReset := FALSE;
END_IF;

fbPower(
    Axis            := Axis_1,
    Enable          := GVL_HMI.AxisCmd.bEnable,
    Enable_Positive := TRUE,
    Enable_Negative := TRUE,
    Override        := 100.0,
    Status          => GVL_AxisInternal.Axis1.bPowerStatus,
    Error           => GVL_AxisInternal.Axis1.bPowerError,
    ErrorID         => GVL_AxisInternal.Axis1.nPowerErrorID
);

// =====================================================
// 4. 状态预处理：供本周期命令互锁使用
// =====================================================
bErrorForCmd := GVL_AxisInternal.Axis1.bPowerError
             OR GVL_AxisInternal.Axis1.bResetError
             OR GVL_AxisInternal.Axis1.bMoveRelError
             OR GVL_AxisInternal.Axis1.bMoveAbsError
             OR GVL_AxisInternal.Axis1.bStopError
             OR GVL_AxisInternal.Axis1.bJogError
             OR GVL_AxisInternal.Axis1.bJogHaltError;

bBusyForNewCmd := GVL_AxisInternal.Axis1.bResetBusy
               OR GVL_AxisInternal.Axis1.bMoveRelBusy
               OR GVL_AxisInternal.Axis1.bMoveAbsBusy
               OR GVL_AxisInternal.Axis1.bStopBusy
               OR GVL_AxisInternal.Axis1.bJogBusy
               OR GVL_AxisInternal.Axis1.bJogHaltBusy;

// 点动保持时不能被自身 bJogBusy 阻断，所以这里不包含 bJogBusy
bBusyForJog := GVL_AxisInternal.Axis1.bResetBusy
            OR GVL_AxisInternal.Axis1.bMoveRelBusy
            OR GVL_AxisInternal.Axis1.bMoveAbsBusy
            OR GVL_AxisInternal.Axis1.bStopBusy
            OR GVL_AxisInternal.Axis1.bJogHaltBusy;

// =====================================================
// 5. Stop 最高优先级：停止时取消点动命令和 Halt 请求
// =====================================================
IF GVL_HMI.AxisCmd.bStop THEN
    GVL_HMI.AxisCmd.bJogPos := FALSE;
    GVL_HMI.AxisCmd.bJogNeg := FALSE;
    bJogExecute := FALSE;
    bJogHaltReq := FALSE;
END_IF;

// =====================================================
// 6. 相对运动
// =====================================================
bMoveRelExec := trigMoveRel.Q
                AND NOT trigMoveAbs.Q
                AND GVL_AxisInternal.Axis1.bPowerStatus
                AND NOT bBusyForNewCmd
                AND NOT GVL_HMI.AxisCmd.bStop
                AND NOT GVL_HMI.AxisCmd.bJogPos
                AND NOT GVL_HMI.AxisCmd.bJogNeg
                AND NOT bErrorForCmd;

fbMoveRel(
    Axis         := Axis_1,
    Execute      := bMoveRelExec,
    Distance     := fRelDistanceChecked,
    Velocity     := GVL_AxisCfg.fMoveVelocity,
    Acceleration := GVL_AxisCfg.fMoveAcc,
    Deceleration := GVL_AxisCfg.fMoveDec,
    Done         => GVL_AxisInternal.Axis1.bMoveRelDone,
    Busy         => GVL_AxisInternal.Axis1.bMoveRelBusy,
    Error        => GVL_AxisInternal.Axis1.bMoveRelError,
    ErrorID      => GVL_AxisInternal.Axis1.nMoveRelErrorID
);

IF trigMoveRel.Q THEN
    GVL_HMI.AxisCmd.bMoveRel := FALSE;
END_IF;

// =====================================================
// 7. 绝对运动
// =====================================================
bMoveAbsExec := trigMoveAbs.Q
                AND NOT trigMoveRel.Q
                AND GVL_AxisInternal.Axis1.bPowerStatus
                AND NOT bBusyForNewCmd
                AND NOT GVL_HMI.AxisCmd.bStop
                AND NOT GVL_HMI.AxisCmd.bJogPos
                AND NOT GVL_HMI.AxisCmd.bJogNeg
                AND NOT bErrorForCmd;

fbMoveAbs(
    Axis         := Axis_1,
    Execute      := bMoveAbsExec,
    Position     := fAbsPositionChecked,
    Velocity     := GVL_AxisCfg.fMoveVelocity,
    Acceleration := GVL_AxisCfg.fMoveAcc,
    Deceleration := GVL_AxisCfg.fMoveDec,
    Done         => GVL_AxisInternal.Axis1.bMoveAbsDone,
    Busy         => GVL_AxisInternal.Axis1.bMoveAbsBusy,
    Error        => GVL_AxisInternal.Axis1.bMoveAbsError,
    ErrorID      => GVL_AxisInternal.Axis1.nMoveAbsErrorID
);

IF trigMoveAbs.Q THEN
    GVL_HMI.AxisCmd.bMoveAbs := FALSE;
END_IF;

// =====================================================
// 8. 点动 MoveVelocity
// =====================================================
bJogExecute := FALSE;

IF GVL_HMI.AxisCmd.bJogPos
   AND NOT GVL_HMI.AxisCmd.bJogNeg
   AND GVL_AxisInternal.Axis1.bPowerStatus
   AND NOT bBusyForJog
   AND NOT GVL_HMI.AxisCmd.bStop
   AND NOT bErrorForCmd THEN

    eJogDir := MC_Positive_Direction;
    bJogExecute := TRUE;

ELSIF GVL_HMI.AxisCmd.bJogNeg
      AND NOT GVL_HMI.AxisCmd.bJogPos
      AND GVL_AxisInternal.Axis1.bPowerStatus
      AND NOT bBusyForJog
      AND NOT GVL_HMI.AxisCmd.bStop
      AND NOT bErrorForCmd THEN

    eJogDir := MC_Negative_Direction;
    bJogExecute := TRUE;
ELSE
    bJogExecute := FALSE;
END_IF;

fbJogVel(
    Axis           := Axis_1,
    Execute        := bJogExecute,
    Velocity       := GVL_AxisCfg.fJogVelocity,
    Acceleration   := GVL_AxisCfg.fJogAcc,
    Deceleration   := GVL_AxisCfg.fJogDec,
    Direction      := eJogDir,
    InVelocity     => GVL_AxisInternal.Axis1.bJogInVelocity,
    Busy           => GVL_AxisInternal.Axis1.bJogBusy,
    Active         => GVL_AxisInternal.Axis1.bJogActive,
    CommandAborted => GVL_AxisInternal.Axis1.bJogCommandAborted,
    Error          => GVL_AxisInternal.Axis1.bJogError,
    ErrorID        => GVL_AxisInternal.Axis1.nJogErrorID
);

// =====================================================
// 9. 点动松手后 Halt
// =====================================================
trigJogRelease(CLK := bJogExecute);

IF trigJogRelease.Q AND NOT GVL_HMI.AxisCmd.bStop THEN
    bJogHaltReq := TRUE;
END_IF;

fbJogHalt(
    Axis         := Axis_1,
    Execute      := bJogHaltReq,
    Deceleration := GVL_AxisCfg.fJogDec,
    Done         => GVL_AxisInternal.Axis1.bJogHaltDone,
    Busy         => GVL_AxisInternal.Axis1.bJogHaltBusy,
    Active       => GVL_AxisInternal.Axis1.bJogHaltActive,
    Error        => GVL_AxisInternal.Axis1.bJogHaltError,
    ErrorID      => GVL_AxisInternal.Axis1.nJogHaltErrorID
);

IF GVL_AxisInternal.Axis1.bJogHaltDone OR GVL_AxisInternal.Axis1.bJogHaltError THEN
    bJogHaltReq := FALSE;
END_IF;

// =====================================================
// 10. Stop
// =====================================================
fbStop(
    Axis         := Axis_1,
    Execute      := GVL_HMI.AxisCmd.bStop,
    Deceleration := GVL_AxisCfg.fMoveDec,
    Done         => GVL_AxisInternal.Axis1.bStopDone,
    Busy         => GVL_AxisInternal.Axis1.bStopBusy,
    Error        => GVL_AxisInternal.Axis1.bStopError,
    ErrorID      => GVL_AxisInternal.Axis1.nStopErrorID
);

IF GVL_AxisInternal.Axis1.bStopDone OR GVL_AxisInternal.Axis1.bStopError THEN
    GVL_HMI.AxisCmd.bStop := FALSE;
END_IF;

// =====================================================
// 11. 命令拒绝提示
// =====================================================
IF trigReset.Q OR bMoveRelExec OR bMoveAbsExec OR GVL_HMI.AxisCmd.bStop OR bJogExecute THEN
    GVL_HMI.AxisSts.bCmdRejected := FALSE;
    GVL_HMI.AxisSts.nRejectReason := 0;
END_IF;

IF trigMoveRel.Q AND NOT bMoveRelExec THEN
    GVL_HMI.AxisSts.bCmdRejected := TRUE;
    GVL_HMI.AxisSts.nRejectReason := 1; // 相对运动命令被拒绝
ELSIF trigMoveAbs.Q AND NOT bMoveAbsExec THEN
    GVL_HMI.AxisSts.bCmdRejected := TRUE;
    GVL_HMI.AxisSts.nRejectReason := 2; // 绝对运动命令被拒绝
ELSIF GVL_HMI.AxisCmd.bJogPos AND GVL_HMI.AxisCmd.bJogNeg THEN
    GVL_HMI.AxisSts.bCmdRejected := TRUE;
    GVL_HMI.AxisSts.nRejectReason := 3; // 正反点动同时触发
    GVL_HMI.AxisCmd.bJogPos := FALSE;
    GVL_HMI.AxisCmd.bJogNeg := FALSE;
ELSIF (GVL_HMI.AxisCmd.bJogPos XOR GVL_HMI.AxisCmd.bJogNeg) AND NOT bJogExecute THEN
    GVL_HMI.AxisSts.bCmdRejected := TRUE;
    GVL_HMI.AxisSts.nRejectReason := 4; // 点动条件不满足
END_IF;

// =====================================================
// 12. HMI 状态汇总
// =====================================================
GVL_HMI.AxisSts.bPowerStatus := GVL_AxisInternal.Axis1.bPowerStatus;

GVL_HMI.AxisSts.fActPos  := Axis_1.NcToPlc.ActPos;
GVL_HMI.AxisSts.fSetPos  := Axis_1.NcToPlc.SetPos;
GVL_HMI.AxisSts.fActVelo := Axis_1.NcToPlc.ActVelo;

IF GVL_AxisCfg.fMmPerRev > 0.0 THEN
    GVL_HMI.AxisSts.fActRpm := GVL_HMI.AxisSts.fActVelo * 60.0 / GVL_AxisCfg.fMmPerRev;
ELSE
    GVL_HMI.AxisSts.fActRpm := 0.0;
END_IF;

GVL_HMI.AxisSts.fPosDiff := GVL_HMI.AxisSts.fSetPos - GVL_HMI.AxisSts.fActPos;

GVL_HMI.AxisSts.bBusy := GVL_AxisInternal.Axis1.bResetBusy
                      OR GVL_AxisInternal.Axis1.bMoveRelBusy
                      OR GVL_AxisInternal.Axis1.bMoveAbsBusy
                      OR GVL_AxisInternal.Axis1.bStopBusy
                      OR GVL_AxisInternal.Axis1.bJogBusy
                      OR GVL_AxisInternal.Axis1.bJogHaltBusy;

GVL_HMI.AxisSts.bError := GVL_AxisInternal.Axis1.bPowerError
                       OR GVL_AxisInternal.Axis1.bResetError
                       OR GVL_AxisInternal.Axis1.bMoveRelError
                       OR GVL_AxisInternal.Axis1.bMoveAbsError
                       OR GVL_AxisInternal.Axis1.bStopError
                       OR GVL_AxisInternal.Axis1.bJogError
                       OR GVL_AxisInternal.Axis1.bJogHaltError;

IF GVL_AxisInternal.Axis1.bPowerError THEN
    GVL_HMI.AxisSts.nErrorID := GVL_AxisInternal.Axis1.nPowerErrorID;
ELSIF GVL_AxisInternal.Axis1.bResetError THEN
    GVL_HMI.AxisSts.nErrorID := GVL_AxisInternal.Axis1.nResetErrorID;
ELSIF GVL_AxisInternal.Axis1.bMoveRelError THEN
    GVL_HMI.AxisSts.nErrorID := GVL_AxisInternal.Axis1.nMoveRelErrorID;
ELSIF GVL_AxisInternal.Axis1.bMoveAbsError THEN
    GVL_HMI.AxisSts.nErrorID := GVL_AxisInternal.Axis1.nMoveAbsErrorID;
ELSIF GVL_AxisInternal.Axis1.bStopError THEN
    GVL_HMI.AxisSts.nErrorID := GVL_AxisInternal.Axis1.nStopErrorID;
ELSIF GVL_AxisInternal.Axis1.bJogError THEN
    GVL_HMI.AxisSts.nErrorID := GVL_AxisInternal.Axis1.nJogErrorID;
ELSIF GVL_AxisInternal.Axis1.bJogHaltError THEN
    GVL_HMI.AxisSts.nErrorID := GVL_AxisInternal.Axis1.nJogHaltErrorID;
ELSE
    GVL_HMI.AxisSts.nErrorID := 0;
END_IF;

// 运动状态编号：0 Disabled, 1 Standstill, 2 Moving, 3 Jogging, 4 Stopping, 5 Error, 6 Resetting
IF GVL_HMI.AxisSts.bError THEN
    GVL_HMI.AxisSts.nMotionState := 5;
ELSIF NOT GVL_HMI.AxisSts.bPowerStatus THEN
    GVL_HMI.AxisSts.nMotionState := 0;
ELSIF GVL_AxisInternal.Axis1.bResetBusy THEN
    GVL_HMI.AxisSts.nMotionState := 6;
ELSIF GVL_AxisInternal.Axis1.bStopBusy OR GVL_AxisInternal.Axis1.bJogHaltBusy THEN
    GVL_HMI.AxisSts.nMotionState := 4;
ELSIF GVL_AxisInternal.Axis1.bJogBusy THEN
    GVL_HMI.AxisSts.nMotionState := 3;
ELSIF GVL_AxisInternal.Axis1.bMoveRelBusy OR GVL_AxisInternal.Axis1.bMoveAbsBusy THEN
    GVL_HMI.AxisSts.nMotionState := 2;
ELSE
    GVL_HMI.AxisSts.nMotionState := 1;
END_IF;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>