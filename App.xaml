<prism:PrismApplication x:Class="ZNQInterface.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ZNQInterface"
    xmlns:prism="http://prismlibrary.com/" >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- 全局控件与页面共用样式 -->
                <ResourceDictionary Source="/Resources/PanelStyles.xaml"/>
                <ResourceDictionary Source="/Resources/ButtonStyles.xaml"/>
                <!-- 数据表格与分页控件样式 -->
                <ResourceDictionary Source="/Resources/DataGridStyles.xaml"/>
                <ResourceDictionary Source="/Resources/PaginationStyles.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
