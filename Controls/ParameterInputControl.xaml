<UserControl x:Class="ZNQInterface.Controls.ParameterInputControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZNQInterface.Controls"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
    <Border Padding="8,4"
        Background="#FFF9FAFB"
        BorderBrush="#FFE5E7EB"
        BorderThickness="1"
        CornerRadius="3">

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 描述 -->
                <ColumnDefinition Width="Auto"/>

                <!-- 可填写范围 -->
                <ColumnDefinition Width="Auto"/>

                <!-- 输入框 -->
                <ColumnDefinition Width="120"/>

                <!-- 单位 -->
                <ColumnDefinition Width="Auto"/>

                <!-- 按钮 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 描述文字 -->
            <TextBlock Grid.Column="0"
                Text="{Binding Description,
                ElementName=Root}"
                FontSize="14"
                VerticalAlignment="Center"/>

            <!-- 可填写范围 -->
            <TextBlock Grid.Column="1"
                Margin="3,0,8,0"
                Text="{Binding RangeText,
                ElementName=Root}"
                FontSize="12"
                Foreground="#FF6B7280"
                VerticalAlignment="Center"/>

            <!-- 数值输入 -->
            <TextBox Grid.Column="2"
                Height="34"
                Padding="6,2"
                Text="{Binding InputText,
                ElementName=Root,
                Mode=TwoWay,
                UpdateSourceTrigger=PropertyChanged}"
                FontSize="14"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>

            <!-- 单位 -->
            <TextBlock Grid.Column="3"
                Margin="6,0,8,0"
                Text="{Binding Unit,
                ElementName=Root}"
                FontSize="14"
                VerticalAlignment="Center"/>

            <!-- 操作按钮 -->
            <Button Grid.Column="4"
                Width="120"
                Margin="5,0"
                Content="{Binding ButtonText,
                ElementName=Root}"
                Command="{Binding ButtonCommand,
                ElementName=Root}"
                CommandParameter="{Binding ButtonCommandParameter,
                ElementName=Root}"
                IsEnabled="{Binding IsActionEnabled,
                ElementName=Root}"
                Style="{StaticResource NormalButtonStyle}"
                Background="#FF2563EB"
                BorderBrush="#FF1D4ED8"
                />
        </Grid>
    </Border>
</UserControl>
