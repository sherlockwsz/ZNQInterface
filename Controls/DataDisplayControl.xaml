<UserControl x:Class="ZNQInterface.Controls.DataDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZNQInterface.Controls"
    mc:Ignorable="d"
    d:DesignHeight="60"
    d:DesignWidth="800">

    <!--
    设备总览轴数据卡片。

    视觉风格与ManualControlView中的AxisItemTemplate保持一致：
    1. 白色背景；
    2. 灰色细边框；
    3. 4像素圆角；
    4. 名称使用半粗字体；
    5. 数据突出显示；
    6. 运动状态使用蓝色。
    -->
    <Border
    Margin="3"
    Padding="8,4"
    Background="White"
    BorderBrush="#FFD1D5DB"
    BorderThickness="1"
    CornerRadius="4"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 轴名称 -->
                <ColumnDefinition Width="4*"/>

                <!-- 实时数据 -->
                <ColumnDefinition Width="2.5*"/>

                <!-- 单位 -->
                <ColumnDefinition Width="1.5*"/>

                <!-- 运动状态 -->
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 轴名称 -->
            <TextBlock
                Grid.Column="0"
                Margin="2,0,4,0"
                Text="{Binding Description,
                    RelativeSource={RelativeSource
                        AncestorType={x:Type local:DataDisplayControl}},
                    TargetNullValue=--,
                    FallbackValue=--}"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#FF1F2937"
                TextTrimming="CharacterEllipsis"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>

            <!-- 实时数据 -->
            <TextBlock
                Grid.Column="1"
                Margin="2,0"
                Text="{Binding DisplayValue,
                    RelativeSource={RelativeSource
                        AncestorType={x:Type local:DataDisplayControl}},
                    TargetNullValue=--,
                    FallbackValue=--}"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#FF111827"
                TextAlignment="Left"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"/>

            <!-- 数据单位 -->
            <TextBlock
                Grid.Column="2"
                Margin="3,0,6,0"
                Text="{Binding Unit,
                    RelativeSource={RelativeSource
                        AncestorType={x:Type local:DataDisplayControl}},
                    TargetNullValue='',
                    FallbackValue=''}"
                FontSize="13"
                Foreground="#FF6B7280"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"/>

            <!-- 轴运动状态 -->
            <TextBlock
                Grid.Column="3"
                Margin="4,0,2,0"
                Text="{Binding AxisStatus,
                    RelativeSource={RelativeSource
                        AncestorType={x:Type local:DataDisplayControl}},
                    TargetNullValue=--,
                    FallbackValue=--}"
                FontSize="14"
                Foreground="#FF2563EB"
                TextTrimming="CharacterEllipsis"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>