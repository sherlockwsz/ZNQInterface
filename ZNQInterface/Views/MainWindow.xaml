<Window x:Class="ZNQInterface.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Height="720"
        Width="1280"
        MinHeight="450"
        MinWidth="800"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F4F6">
    <!-- 页面纵向比例：顶部 8%、中部 84%、底部 8%；顶部横向比例：左侧 10%、右侧 90%。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="8*" />
            <RowDefinition Height="84*" />
            <RowDefinition Height="8*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF1F2937">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="8*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          Margin="12,10"
                          Padding="8,4"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Background="#FF4B5563"
                          BorderBrush="#FF6B7280"
                          Foreground="Black"
                          FontSize="20"
                          ItemsSource="{Binding NavigationItems}"
                          MaxDropDownHeight="420"
                          SelectedItem="{Binding SelectedNavigationItem,
                                                 Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Title" >
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="FontSize" Value="20" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <TextBlock Grid.Column="1"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="35"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="{Binding Title}" />

                <Button Grid.Column="2"
                        Width="130"
                        Height="44"
                        Margin="6,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        Foreground="Black"
                        FontSize="20"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Content="退出软件"/>

            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="5"
                Background="White"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="6">
            <ContentControl
                prism:RegionManager.RegionName="ContentRegion" />
        </Border>

        <Border Grid.Row="2"
                Background="#FF111827">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="4.1*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="设备运行状态：运行中" />

                <TextBlock Grid.Column="1"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="当前报警：0x0010，上下料机构X轴超出限位" />


                <TextBlock Grid.Column="2"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="ADS通信：未连接" />

                <TextBlock Grid.Column="3"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="运行模式：自动" />

                <TextBlock Grid.Column="4"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="{Binding CurrentSystemTime}" />
            </Grid>
        </Border>
    </Grid>
</Window>
