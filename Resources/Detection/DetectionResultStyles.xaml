<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    检测结果显示样式。

    IsQualified为：
    null  → 尚未判定；
    true  → 合格；
    false → 不合格。
    -->
    <Style
        x:Key="QualificationResultTextStyle"
        TargetType="{x:Type TextBlock}">

        <!-- 公共外观 -->
        <Setter
            Property="FontSize"
            Value="15"/>

        <Setter
            Property="VerticalAlignment"
            Value="Center"/>

        <!-- 默认状态：尚未判定 -->
        <Setter
            Property="Text"
            Value="--"/>

        <Setter
            Property="Foreground"
            Value="#FF9CA3AF"/>

        <Style.Triggers>

            <!-- 合格 -->
            <DataTrigger
                Binding="{Binding IsQualified}"
                Value="True">

                <Setter
                    Property="Text"
                    Value="合格"/>

                <Setter
                    Property="Foreground"
                    Value="#FF4ADE80"/>

            </DataTrigger>

            <!-- 不合格 -->
            <DataTrigger
                Binding="{Binding IsQualified}"
                Value="False">

                <Setter
                    Property="Text"
                    Value="不合格"/>

                <Setter
                    Property="Foreground"
                    Value="#FFF87171"/>

            </DataTrigger>

        </Style.Triggers>
    </Style>

</ResourceDictionary>