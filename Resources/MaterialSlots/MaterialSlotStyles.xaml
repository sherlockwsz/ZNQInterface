<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:slotModels="clr-namespace:ZNQInterface.ViewModels.Components.MaterialSlots">

    <!-- 未知：ADS未连接、读取失败或PLC返回未知值 -->
    <SolidColorBrush
        x:Key="MaterialSlotUnknownBrush"
        Color="#808080"/>

    <!-- 空料位 -->
    <SolidColorBrush
        x:Key="MaterialSlotEmptyBrush"
        Color="#B0BEC5"/>

    <!-- 未调整 -->
    <SolidColorBrush
        x:Key="MaterialSlotUnadjustedBrush"
        Color="#FBC02D"/>

    <!-- 待调整 -->
    <SolidColorBrush
        x:Key="MaterialSlotPendingAdjustmentBrush"
        Color="#FB8C00"/>

    <!-- 调整中 -->
    <SolidColorBrush
        x:Key="MaterialSlotAdjustingBrush"
        Color="#1E88E5"/>

    <!-- 合格 -->
    <SolidColorBrush
        x:Key="MaterialSlotQualifiedBrush"
        Color="#43A047"/>

    <!-- 不合格 -->
    <SolidColorBrush
        x:Key="MaterialSlotUnqualifiedBrush"
        Color="#E53935"/>

    <!-- 单个料位指示灯样式 -->
    <Style
        x:Key="MaterialSlotIndicatorStyle"
        TargetType="{x:Type Ellipse}">

        <Setter Property="Width"
                Value="24"/>

        <Setter Property="Height"
                Value="24"/>

        <Setter Property="StrokeThickness"
                Value="2"/>

        <!-- 没有匹配到任何状态时按Unknown显示 -->
        <Setter Property="Fill"
                Value="{StaticResource MaterialSlotUnknownBrush}"/>

        <Setter Property="Stroke"
                Value="#FF374151"/>

        <Style.Triggers>

            <!-- 空 -->
            <DataTrigger
                Binding="{Binding State}"
                Value="{x:Static slotModels:MaterialSlotState.Empty}">

                <Setter
                    Property="Fill"
                    Value="{StaticResource MaterialSlotEmptyBrush}"/>

                <Setter
                    Property="Stroke"
                    Value="#FF6B7280"/>
            </DataTrigger>

            <!-- 未调整 -->
            <DataTrigger
                Binding="{Binding State}"
                Value="{x:Static slotModels:MaterialSlotState.Unadjusted}">

                <Setter
                    Property="Fill"
                    Value="{StaticResource MaterialSlotUnadjustedBrush}"/>

                <Setter
                    Property="Stroke"
                    Value="#FFD97706"/>
            </DataTrigger>

            <!-- 待调整 -->
            <DataTrigger
                Binding="{Binding State}"
                Value="{x:Static slotModels:MaterialSlotState.PendingAdjustment}">

                <Setter
                    Property="Fill"
                    Value="{StaticResource MaterialSlotPendingAdjustmentBrush}"/>

                <Setter
                    Property="Stroke"
                    Value="#FFC2410C"/>
            </DataTrigger>

            <!-- 调整中 -->
            <DataTrigger
                Binding="{Binding State}"
                Value="{x:Static slotModels:MaterialSlotState.Adjusting}">

                <Setter
                    Property="Fill"
                    Value="{StaticResource MaterialSlotAdjustingBrush}"/>

                <Setter
                    Property="Stroke"
                    Value="#FF1D4ED8"/>
            </DataTrigger>

            <!-- 合格 -->
            <DataTrigger
                Binding="{Binding State}"
                Value="{x:Static slotModels:MaterialSlotState.Qualified}">

                <Setter
                    Property="Fill"
                    Value="{StaticResource MaterialSlotQualifiedBrush}"/>

                <Setter
                    Property="Stroke"
                    Value="#FF15803D"/>
            </DataTrigger>

            <!-- 不合格 -->
            <DataTrigger
                Binding="{Binding State}"
                Value="{x:Static slotModels:MaterialSlotState.Unqualified}">

                <Setter
                    Property="Fill"
                    Value="{StaticResource MaterialSlotUnqualifiedBrush}"/>

                <Setter
                    Property="Stroke"
                    Value="#FFB91C1C"/>
            </DataTrigger>

        </Style.Triggers>
    </Style>

    <!-- 状态文字样式 -->
    <Style
        x:Key="MaterialSlotStatusTextStyle"
        TargetType="{x:Type TextBlock}">

        <Setter
            Property="Margin"
            Value="0,4,0,0"/>

        <Setter
            Property="FontSize"
            Value="12"/>

        <Setter
            Property="Foreground"
            Value="#FF374151"/>

        <Setter
            Property="HorizontalAlignment"
            Value="Center"/>
    </Style>

</ResourceDictionary>