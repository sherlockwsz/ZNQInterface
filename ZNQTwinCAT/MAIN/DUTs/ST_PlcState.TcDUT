<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_PlcState" Id="{a722d5f2-042d-45dc-ba46-173b0e0efbde}">
    <Declaration><![CDATA[TYPE ST_PlcState :
STRUCT
    Heartbeat      : UDINT;           // PLC 心跳
    AckSeq         : UDINT;           // 已响应的命令序号
    MachineState   : E_MachineState;  // 设备总状态
    CurrentStep    : E_AutoStep;      // 当前自动工步
    AlarmCode      : UDINT;           // 当前报警代码

    AutoRunning    : BOOL;            // 自动运行中
    Paused         : BOOL;            // 暂停中
    AxisAllReady   : BOOL;            // 所有轴就绪
    EtherCATReady  : BOOL;            // EtherCAT 正常

    CurrentTray    : UINT;            // 当前料盘编号
    CurrentRow     : UINT;            // 当前行
    CurrentColumn  : UINT;            // 当前列

    GoodCount      : UDINT;           // OK 数量
    NgCount        : UDINT;           // NG 数量
    CycleTimeMs    : LREAL;           // 单件节拍
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>