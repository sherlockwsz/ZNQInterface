<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_HostCmd" Id="{e88662ef-bddc-4b61-9d07-6a1c602442a5}">
    <Declaration><![CDATA[TYPE ST_HostCmd :
STRUCT
    Heartbeat       : UDINT;        // 上位机心跳
    CmdSeq          : UDINT;        // 命令序号，每发一次命令加 1
    CmdId           : E_HostCmdId;  // 命令编号
    RecipeId        : UINT;         // 配方号
    ManualStationId : UINT;         // 手动工位编号
    ManualActionId  : UINT;         // 手动动作编号
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>