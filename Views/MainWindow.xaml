<Window x:Class="ZNQInterface.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{Binding Title}"
        Height="720"
        Width="1280"
        MinHeight="450"
        MinWidth="800"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F4F6">
    <!-- 页面纵向比例：顶部 8%、中部 84%、底部 8%；顶部横向比例：左侧 10%、右侧 90%。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF1F2937">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <!--导航下拉框-->
                <ComboBox Grid.Column="0"
                          Width="190"
                          Height="50"
                          Margin="12,0,0,0"
                          Padding="8,4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Background="#FF4B5563"
                          BorderBrush="#FF6B7280"
                          Foreground="Black"
                          FontSize="20"
                          ItemsSource="{Binding NavigationItems}"
                          MaxDropDownHeight="420"
                          SelectedItem="{Binding SelectedNavigationItem,
                                                 Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Title" >
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="FontSize" Value="20" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <!--剧中标题-->
                <TextBlock Grid.Column="1"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="35"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="{Binding Title}" />
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 开始连接按钮 -->
                    <Grid Grid.Column="0"
                          Margin="20,0,10,0">
                        <ToggleButton>
                            <ToggleButton.Style>
                                <Style TargetType="{x:Type ToggleButton}"
                                       BasedOn="{StaticResource ToggleStateButtonStyle}">

                                    <!-- 初始状态 -->
                                    <Setter Property="Content"
                                            Value="开始连接"/>

                                    <Setter Property="Background"
                                            Value="Blue"/>

                                    <Setter Property="BorderBrush"
                                            Value="Blue"/>

                                    <!-- 切换状态 -->
                                    <Style.Triggers>

                                        <Trigger Property="IsChecked"
                                                 Value="True">

                                            <Setter Property="Content"
                                                    Value="断开连接"/>

                                            <Setter Property="Background"
                                                    Value="Red"/>

                                            <Setter Property="BorderBrush"
                                                    Value="Red"/>

                                        </Trigger>

                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>

                        </ToggleButton>
                    </Grid>
                    <!-- 启动设备按钮 -->
                    <Grid Grid.Column="1"
                          Margin="10,0,10,0">
                        <ToggleButton>
                            <ToggleButton.Style>
                                <Style TargetType="{x:Type ToggleButton}"
                                       BasedOn="{StaticResource ToggleStateButtonStyle}">

                                    <!-- 初始状态 -->
                                    <Setter Property="Content"
                                            Value="启动设备"/>

                                    <Setter Property="Background"
                                            Value="Green"/>

                                    <Setter Property="BorderBrush"
                                            Value="Green"/>

                                    <!-- 切换状态 -->
                                    <Style.Triggers>

                                        <Trigger Property="IsChecked"
                                                 Value="True">

                                            <Setter Property="Content"
                                                    Value="停止设备"/>

                                            <Setter Property="Background"
                                                    Value="Red"/>

                                            <Setter Property="BorderBrush"
                                                    Value="Red"/>

                                        </Trigger>

                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>

                        </ToggleButton>
                    </Grid>
                    <!-- 故障复位按钮 -->
                    <Grid Grid.Column="2"
                          Margin="10,0,10,0">
                        <Button Content="故障复位"
                                Style="{StaticResource NormalButtonStyle}"
                                Background="Orange"
                                BorderBrush="Orange"/>
                    </Grid>
                    <!-- 退出软件按钮 -->
                    <Grid Grid.Column="3"
                          Margin="10,0,20,0">
                        <Button Content="软件退出"
                                Style="{StaticResource NormalButtonStyle}"
                                Background="Gray"
                                BorderBrush="Gray"
                                Command="{Binding ExitApplicationCommand}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="5"
                Background="White"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="6">
            <ContentControl
                prism:RegionManager.RegionName="ContentRegion" />
        </Border>

        <Border Grid.Row="2"
                Background="#FF111827">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="4.1*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="设备运行状态：运行中" />

                <TextBlock Grid.Column="1"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="当前报警：0x0010，上下料机构X轴超出限位" />


                <TextBlock Grid.Column="2"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="ADS通信：未连接" />

                <TextBlock Grid.Column="3"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="运行模式：自动" />

                <TextBlock Grid.Column="4"
                           Margin="12,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="White"
                           Text="{Binding CurrentSystemTime}" />
            </Grid>
        </Border>
    </Grid>
</Window>
