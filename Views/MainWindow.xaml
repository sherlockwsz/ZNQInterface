<Window x:Class="ZNQInterface.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:communicationModels= "clr-namespace:ZNQInterface.Models.Communication"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Title="{Binding Title}"
    Height="720"
    Width="1280"
    MinHeight="450"
    MinWidth="800"
    WindowState="Maximized"
    ResizeMode="NoResize"
    WindowStyle="None"
    WindowStartupLocation="CenterScreen"
    Background="#FFF3F4F6">
    <!-- 页面纵向比例：顶部 8%、中部 84%、底部 8%；顶部横向比例：左侧 10%、右侧 90%。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="#FF1F2937">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <!-- 左侧：页面导航下拉框 -->
                <ComboBox Grid.Column="0"
                    Width="190"
                    Height="50"
                    Margin="12,0,0,0"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#FF4B5563"
                    BorderBrush="#FF6B7280"
                    Foreground="Black"
                    FontSize="20"
                    ItemsSource="{Binding NavigationItems}"
                    MaxDropDownHeight="420"
                    SelectedItem="{Binding SelectedNavigationItem,
                    Mode=TwoWay,
                    UpdateSourceTrigger=PropertyChanged}"
                    DisplayMemberPath="Title" >
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="FontSize" Value="20" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <!-- 中间：窗口标题 -->
                <TextBlock Grid.Column="1"
                    Margin="12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="35"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding Title}" />
                <!-- 右侧操作按钮 -->
                <Grid Grid.Column="2">
                    <Grid.Resources>
                        <DataTemplate x:Key="TopButtonContentTemplate">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding}"/>
                            </Viewbox>
                        </DataTemplate>
                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 开始连接按钮 -->
                    <Grid Grid.Column="0"
                        Margin="4,0,4,0">
                        <ToggleButton MinWidth="0" Height="44" Padding="2,6" FontSize="14"
                            HorizontalContentAlignment="Stretch"
                            ContentTemplate="{StaticResource TopButtonContentTemplate}"
                            Command="{Binding ToggleAdsConnectionCommand}"
                            IsChecked="{Binding IsAdsConnected, Mode=OneWay}"
                            ToolTip="应用启动后自动连接本机 PLC Runtime 1（ADS 851）">
                            <ToggleButton.Style>
                                <Style TargetType="{x:Type ToggleButton}"
                                    BasedOn="{StaticResource ToggleStateButtonStyle}">

                                    <!-- 初始状态 -->
                                    <Setter Property="Content"
                                        Value="开始连接"/>

                                    <Setter Property="Background"
                                        Value="Blue"/>

                                    <Setter Property="BorderBrush"
                                        Value="Blue"/>

                                    <!-- 切换状态 -->
                                    <Style.Triggers>

                                        <Trigger Property="IsChecked"
                                            Value="True">

                                            <Setter Property="Content"
                                                Value="断开连接"/>

                                            <Setter Property="Background"
                                                Value="Red"/>

                                            <Setter Property="BorderBrush"
                                                Value="Red"/>

                                        </Trigger>

                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>

                        </ToggleButton>
                    </Grid>
                    <!-- 整机准备按钮 -->
                    <Grid Grid.Column="1" Margin="4,0,4,0">
                        <Button MinWidth="0" Height="44" Padding="2,6" FontSize="14"
                            HorizontalContentAlignment="Stretch"
                            ContentTemplate="{StaticResource TopButtonContentTemplate}"
                            Content="{Binding PrepareButtonText}"
                            Command="{Binding PrepareMachineCommand}"
                            ToolTip="{Binding PreparationStatusText}"
                            Style="{StaticResource NormalButtonStyle}"
                            Background="Teal" BorderBrush="Teal"/>
                    </Grid>
                    <!-- 启动设备按钮 -->
                    <Grid Grid.Column="2"
                        Margin="4,0,4,0">
                        <ToggleButton MinWidth="0" Height="44" Padding="2,6" FontSize="14"
                            HorizontalContentAlignment="Stretch"
                            ContentTemplate="{StaticResource TopButtonContentTemplate}"
                            Command="{Binding ToggleDeviceControlCommand}"
                            IsChecked="{Binding IsControlAuto, Mode=OneWay}"
                            Content="{Binding DeviceButtonText}"
                            Background="{Binding DeviceButtonBackground}"
                            BorderBrush="{Binding DeviceButtonBorderBrush}"
                            ToolTip="{Binding DeviceStatusText}"
                            Style="{StaticResource ToggleStateButtonStyle}" />
                    </Grid>
                    <!-- 故障复位按钮 -->
                    <Grid Grid.Column="3"
                        Margin="4,0,4,0">
                        <Button MinWidth="0" Height="44" Padding="2,6" FontSize="14"
                            HorizontalContentAlignment="Stretch"
                            ContentTemplate="{StaticResource TopButtonContentTemplate}" Content="故障复位"
                            Command="{Binding ResetMachineFaultCommand}"
                            ToolTip="{Binding DeviceStatusText}"
                            Style="{StaticResource NormalButtonStyle}"
                            Background="Orange"
                            BorderBrush="Orange"/>
                    </Grid>
                    <!-- 退出软件按钮 -->
                    <Grid Grid.Column="4"
                        Margin="4,0,4,0">
                        <Button MinWidth="0" Height="44" Padding="2,6" FontSize="14"
                            HorizontalContentAlignment="Stretch"
                            ContentTemplate="{StaticResource TopButtonContentTemplate}" Content="软件退出"
                            Style="{StaticResource NormalButtonStyle}"
                            Background="Gray"
                            BorderBrush="Gray"
                            Command="{Binding ExitApplicationCommand}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <!-- 中间：页面内容区域 -->
        <Border Grid.Row="1"
            Padding="5"
            Background="White"
            BorderBrush="#FFE5E7EB"
            BorderThickness="1"
            CornerRadius="6">
            <ContentControl
                prism:RegionManager.RegionName="ContentRegion" />
        </Border>
        <!-- 底部：设备状态与系统信息 -->
        <Border Grid.Row="2"
            Background="#FF111827">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                    Margin="12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="White"
                    Text="{Binding MachineRunStatusText}" />

                <TextBlock Grid.Column="1"
                    Margin="12,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="White"
                    Text="{Binding FaultStatusText}"
                    ToolTip="{Binding FaultStatusText}"
                    TextTrimming="CharacterEllipsis" />


                <!--
ADS连接状态和HMI看门狗状态。

看门狗只使用一个Ellipse指示灯，
具体颜色由WatchdogState统一控制。
-->
                <StackPanel Grid.Column="2"
    Margin="12,0"
    Orientation="Horizontal"
    HorizontalAlignment="Left"
    VerticalAlignment="Center">

                    <!-- 原有ADS连接状态 -->
                    <TextBlock
        VerticalAlignment="Center"
        FontSize="16"
        Foreground="White"
        Text="{Binding AdsStatusText,
            Mode=OneWay}"/>

                    <!-- ADS状态和看门狗状态之间的分隔线 -->
                    <Border
        Width="1"
        Height="24"
        Margin="14,0"
        Background="#FF4B5563"/>

                    <!-- 唯一的看门狗指示灯 -->
                    <Ellipse
        Width="14"
        Height="14"
        Margin="0,0,8,0"
        Stroke="#FFD1D5DB"
        StrokeThickness="1">

                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">

                                <!-- 默认：灰色 -->
                                <Setter Property="Fill"
                    Value="#FF6B7280"/>

                                <Style.Triggers>

                                    <!-- 等待PLC心跳：黄色 -->
                                    <DataTrigger
                        Binding="{Binding WatchdogState}"
                        Value="{x:Static
                            communicationModels:HmiWatchdogState.WaitingHeartbeat}">

                                        <Setter Property="Fill"
                            Value="#FFF59E0B"/>
                                    </DataTrigger>

                                    <!-- 心跳正常且PLC允许控制：绿色 -->
                                    <DataTrigger
                        Binding="{Binding WatchdogState}"
                        Value="{x:Static
                            communicationModels:HmiWatchdogState.Online}">

                                        <Setter Property="Fill"
                            Value="#FF22C55E"/>
                                    </DataTrigger>

                                    <!-- 心跳恢复但仍在等待命令清零：黄色 -->
                                    <DataTrigger
                        Binding="{Binding WatchdogState}"
                        Value="{x:Static
                            communicationModels:HmiWatchdogState.WaitingCommandReset}">

                                        <Setter Property="Fill"
                            Value="#FFF59E0B"/>
                                    </DataTrigger>

                                    <!-- PLC检测到心跳超时：红色 -->
                                    <DataTrigger
                        Binding="{Binding WatchdogState}"
                        Value="{x:Static
                            communicationModels:HmiWatchdogState.Timeout}">

                                        <Setter Property="Fill"
                            Value="#FFEF4444"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- 看门狗动态状态文字 -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="White"
                        Text="{Binding WatchdogStatusText,
                            Mode=OneWay}"/>

                </StackPanel>
                <TextBlock Grid.Column="3"
                    Margin="12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="White"
                    Text="{Binding MachineModeText}" />

                <TextBlock Grid.Column="4"
                    Margin="12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="White"
                    Text="{Binding CurrentSystemTime}" />
            </Grid>
        </Border>
    </Grid>
</Window>
