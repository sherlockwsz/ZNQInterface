<Window x:Class="ZNQInterface.Views.Dialogs.ManualCodeEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="工件二维码人工补录" Width="560" Height="340" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding IdentityText}" TextWrapping="Wrap" FontSize="15"/>
        <TextBlock Grid.Row="1" Margin="0,12,0,8" FontSize="18" Foreground="DarkOrange"
            Text="{Binding RemainingSeconds, StringFormat='剩余 {0:F1} 秒'}"/>
        <TextBox Grid.Row="2" Height="38" FontSize="17" VerticalContentAlignment="Center"
            Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Status}"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="跳过" Command="{Binding SkipCommand}" MinWidth="90" Height="36" Margin="0,0,12,0"/>
            <Button Content="确认补录" Command="{Binding ConfirmCommand}" MinWidth="110" Height="36"/>
        </StackPanel>
    </Grid>
</Window>
