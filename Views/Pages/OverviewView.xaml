<UserControl x:Class="ZNQInterface.Views.Pages.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZNQInterface.Views.Pages"
             xmlns:controls="clr-namespace:ZNQInterface.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!--左侧：设备总览第一列-->
        <Grid Grid.Column="0"
              Margin="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="4*" />
                <RowDefinition Height="5*" />
            </Grid.RowDefinitions>
            <!--第一行第一列分为左右两部分-->
            <Grid Grid.Row="0"
                  Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <!--料位状态-->
                <HeaderedContentControl Grid.Column="0"
                                        Header="料位状态"
                                        Style="{StaticResource TitledPanelStyle}"
                                        Margin="0,0,1,0">

                    <TextBlock Text="主要内容"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </HeaderedContentControl>
                <!--不合格料位-->
                <HeaderedContentControl Grid.Column="1"
                                        Header="不合格料位"
                                        Style="{StaticResource TitledPanelStyle}"
                                        Margin="1,0,0,0">

                    <TextBlock Text="主要内容"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </HeaderedContentControl>
            </Grid>
            <!-- 第二行第一列分为左右两部分 -->
            <Grid Grid.Row="1"
                  Margin="0,1,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：料仓状态 -->
                <HeaderedContentControl Grid.Column="0"
                                        Header="料仓状态"
                                        Style="{StaticResource TitledPanelStyle}"
                                        Margin="0,0,1,0">

                    <TextBlock Text="主要内容"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </HeaderedContentControl>

                <!-- 右侧：直接分为上下料轴和料仓轴 -->
                <Grid Grid.Column="1"
                      Margin="1,0,0,0">

                    <!-- 外层模板只能直接放一个内容控件，因此先放Grid -->
                    <Grid.RowDefinitions>
                        <!-- 上下料轴区域 -->
                        <RowDefinition Height="7*"/>
                        <!-- 料仓轴区域 -->
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <!-- 上下料轴 -->
                    <HeaderedContentControl Grid.Row="0"
                                            Header="上下料轴"
                                            Style="{StaticResource TitledPanelStyle}"
                                            Margin="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="上下料X轴位置："
                                DisplayValue="+125.36"
                                Unit="mm"/>
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,0,0,1"
                                Description="上下料Y轴位置："
                                DisplayValue="+205.36"
                                Unit="mm"/>
                            <controls:DataDisplayControl
                                Grid.Row="2"
                                Margin="0,0,0,1"
                                Description="上下料Z轴位置："
                                DisplayValue="+489.36"
                                Unit="mm"/>
                            <controls:DataDisplayControl
                                Grid.Row="3"
                                Margin="0,0,0,1"
                                Description="末端转轴位置："
                                DisplayValue="+47.68"
                                Unit="°"/>
                            <controls:DataDisplayControl
                                Grid.Row="4"
                                Margin="0,0,0,1"
                                Description="末端夹爪位置："
                                DisplayValue="+16.87"
                                Unit="mm"/>
                        </Grid>
                    </HeaderedContentControl>
                    <!-- 料仓轴 -->
                    <HeaderedContentControl Grid.Row="1"
                                            Header="料仓轴"
                                            Style="{StaticResource TitledPanelStyle}"
                                            Margin="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="料仓X轴位置："
                                DisplayValue="+289.87"
                                Unit="mm"/>
                            
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,0,0,1"
                                Description="料仓Z轴位置："
                                DisplayValue="+756.45"
                                Unit="mm"/>
                        </Grid>
                    </HeaderedContentControl>
                </Grid>
            </Grid>
        </Grid>
        <!--中间：设备总览第二列-->
        <Grid Grid.Column="1"
              Margin="1,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <!--中间上侧实时图像显示-->
            <Grid Grid.Row="0"
                  Margin="0,0,0,1">
                <HeaderedContentControl Header="螺钉角度实时监控"
                                        Style="{StaticResource TitledPanelStyle}"
                                        Margin="1">

                    <!-- 标题下方的内容 -->
                    <TextBlock Text="实时图像"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </HeaderedContentControl>
            </Grid>
            <!--中间下侧内容-->
        </Grid>
        <!--右侧：设备总览第三列-->
        <Grid Grid.Column="2"
              Margin="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <!--右边上侧实时图像显示-->
            <Grid Grid.Row="0"
                  Margin="0,0,0,1">
                <HeaderedContentControl Header="同轴度实时监控"
                                        Style="{StaticResource TitledPanelStyle}"
                                        Margin="1">

                    <!-- 标题下方的内容 -->
                    <TextBlock Text="实时图像"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </HeaderedContentControl>
            </Grid>
            <!--右边下侧内容-->
            <Grid Grid.Row="1"
                  Margin="0,1,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <!--右下角第一行-->
                <Grid Grid.Row="0"
                      Margin="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!--转台轴数据-->
                    <HeaderedContentControl Grid.Column="0"
                                            Header="转台轴"
                                            Style="{StaticResource TitledPanelStyle}"
                                            Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="转台轴角度："
                                DisplayValue="+180.00"
                                Unit="°"/>
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,0"
                                Description="固定轴位置："
                                DisplayValue="+756.45"
                                Unit="mm"/>
                        </Grid>
                    </HeaderedContentControl>

                    <!--螺丝刀轴数据-->
                    <HeaderedContentControl Grid.Column="1"
                                            Header="螺丝刀轴"
                                            Style="{StaticResource TitledPanelStyle}"
                                            Margin="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="螺丝刀X轴："
                                DisplayValue="+176.78"
                                Unit="mm"/>
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,0"
                                Description="螺丝刀Z轴："
                                DisplayValue="+201.45"
                                Unit="mm"/>
                        </Grid>
                    </HeaderedContentControl>
                </Grid>

                <!--右下角第二行-->
                <Grid Grid.Row="1"
                      Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!--同轴度数据-->
                    <HeaderedContentControl Grid.Column="0"
                                            Header="同轴度数据"
                                            Style="{StaticResource TitledPanelStyle}"
                                            Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <!--同轴度X-->
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,1,0,0"
                                Description="X轴偏差："
                                DisplayValue="+58.87"
                                Unit="mm"/>
                            <!--同轴度Y-->
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,0"
                                Description="Y轴偏差："
                                DisplayValue="-35.67"
                                Unit="mm"/>
                            <!--同轴度数据-->
                            <controls:DataDisplayControl
                                Grid.Row="2"
                                Margin="0,1,0,0"
                                Description="同轴度："
                                DisplayValue="+25.78"
                                Unit="mm"/>
                        </Grid>

                    </HeaderedContentControl>
                    <!--调整轴数据-->
                    <HeaderedContentControl Grid.Column="1"
                                            Header="调整轴"
                                            Style="{StaticResource TitledPanelStyle}"
                                            Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <!--调整轴X-->
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,1,0,0"
                                Description="调整轴X："
                                DisplayValue="+675.78"
                                Unit="mm"/>
                            <!--调整轴Y-->
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,0"
                                Description="调整轴Y："
                                DisplayValue="+715.98"
                                Unit="mm"/>
                            <!--调整轴Z-->
                            <controls:DataDisplayControl
                                Grid.Row="2"
                                Margin="0,1,0,0"
                                Description="调整轴Z："
                                DisplayValue="+487.45"
                                Unit="mm"/>
                        </Grid>
                    </HeaderedContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
