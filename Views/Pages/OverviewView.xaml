<UserControl x:Class="ZNQInterface.Views.Pages.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZNQInterface.Views.Pages"
    xmlns:controls="clr-namespace:ZNQInterface.Controls"
    mc:Ignorable="d"
    d:DesignHeight="960" d:DesignWidth="1920">
    <UserControl.Resources>

        <!-- 料位矩阵行号、列号样式 -->
        <Style x:Key="SlotCoordinateTextStyle"
           TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="Foreground"
                Value="#FF374151"/>

            <Setter Property="HorizontalAlignment"
                Value="Center"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!--左侧：设备总览第一列-->
        <Grid Grid.Column="0"
            Margin="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <!--第一行第一列分为上下两部分-->
            <Grid Grid.Row="0"
                Margin="0,0,0,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!--料位状态-->
                <HeaderedContentControl Style="{StaticResource TitledPanelStyle}">
                    <!-- 自定义料位状态标题栏 -->
                    <HeaderedContentControl.Header>

                        <Grid>
                            <Grid.ColumnDefinitions>

                                <!-- 左侧：标题 -->
                                <ColumnDefinition Width="Auto"/>

                                <!-- 中间：当前调整层数 -->
                                <ColumnDefinition Width="*"/>

                                <!-- 右侧：状态图例 -->
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <!-- 左侧标题 -->
                            <TextBlock Grid.Column="0"
                   Text="料位状态"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="Black"
                   VerticalAlignment="Center"/>

                            <!-- 当前调整层数 -->
                            <TextBlock Grid.Column="1"
                   Margin="16,0,8,0"
                   Text="{Binding WarehouseStatus.CurrentAdjustingLevelText,
                                  Mode=OneWay,
                                  StringFormat=当前调整层数：{0}}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#FF2563EB"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

                            <!-- 右侧料位状态图例 -->
                            <WrapPanel Grid.Column="2"
                   Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

                                <!-- 空 -->
                                <StackPanel Margin="3,0"
                        Orientation="Horizontal">
                                    <Ellipse Width="11"
                         Height="11"
                         Margin="0,0,3,0"
                         Fill="{StaticResource MaterialSlotEmptyBrush}"
                         Stroke="#FF6B7280"
                         StrokeThickness="1"/>
                                    <TextBlock Text="空"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 待检 -->
                                <StackPanel Margin="3,0"
                        Orientation="Horizontal">
                                    <Ellipse Width="11"
                         Height="11"
                         Margin="0,0,3,0"
                         Fill="{StaticResource MaterialSlotWaitingBrush}"
                         Stroke="#FFD97706"
                         StrokeThickness="1"/>
                                    <TextBlock Text="待检"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 调整中 -->
                                <StackPanel Margin="3,0"
                        Orientation="Horizontal">
                                    <Ellipse Width="11"
                         Height="11"
                         Margin="0,0,3,0"
                         Fill="{StaticResource MaterialSlotInspectingBrush}"
                         Stroke="#FF1D4ED8"
                         StrokeThickness="1"/>
                                    <TextBlock Text="调整中"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 合格 -->
                                <StackPanel Margin="3,0"
                        Orientation="Horizontal">
                                    <Ellipse Width="11"
                         Height="11"
                         Margin="0,0,3,0"
                         Fill="{StaticResource MaterialSlotQualifiedBrush}"
                         Stroke="#FF15803D"
                         StrokeThickness="1"/>
                                    <TextBlock Text="合格"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 不合格 -->
                                <StackPanel Margin="3,0"
                        Orientation="Horizontal">
                                    <Ellipse Width="11"
                         Height="11"
                         Margin="0,0,3,0"
                         Fill="{StaticResource MaterialSlotUnqualifiedBrush}"
                         Stroke="#FFB91C1C"
                         StrokeThickness="1"/>
                                    <TextBlock Text="不合格"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 人工调整 -->
                                <StackPanel Margin="3,0"
                        Orientation="Horizontal">
                                    <Ellipse Width="11"
                         Height="11"
                         Margin="0,0,3,0"
                         Fill="{StaticResource MaterialSlotManualAdjustingBrush}"
                         Stroke="#FF6D28D9"
                         StrokeThickness="1"/>
                                    <TextBlock Text="人工调整"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 异常 -->
                                <StackPanel Margin="3,0"
                        Orientation="Horizontal">
                                    <Ellipse Width="11"
                         Height="11"
                         Margin="0,0,3,0"
                         Fill="{StaticResource MaterialSlotFaultBrush}"
                         Stroke="#FF7F1D1D"
                         StrokeThickness="1"/>
                                    <TextBlock Text="异常"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                                </StackPanel>

                            </WrapPanel>

                        </Grid>

                    </HeaderedContentControl.Header>
                    <!-- 料位状态主体：左侧料位矩阵，右侧信息区 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 左侧占80% -->
                            <ColumnDefinition Width="4*"/>
                            <!-- 右侧占20% -->
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：A-D、1-6料位矩阵 -->
                        <Border Grid.Column="0"
                            Margin="0,0,1,0"
                            Padding="1"
                            BorderThickness="1"
                            CornerRadius="4">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 顶部列号 -->
                                    <RowDefinition Height="15"/>

                                    <!-- 指示灯区域 -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <!-- 左侧行号 -->
                                    <ColumnDefinition Width="15"/>

                                    <!-- 料位矩阵 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左上角空白区域 -->
                                <Border Grid.Row="0"
                                    Grid.Column="0"/>

                                <!-- 顶部列号：1-6 -->
                                <UniformGrid Grid.Row="0"
                                    Grid.Column="1"
                                    Rows="1"
                                    Columns="6"
                                    HorizontalAlignment="Stretch">

                                    <TextBlock Text="1"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="2"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="3"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="4"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="5"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="6"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>
                                </UniformGrid>

                                <!-- 左侧行号：A-D -->
                                <UniformGrid Grid.Row="1"
                                     Grid.Column="0"
                                     Rows="4"
                                     Columns="1"
                                     HorizontalAlignment="Stretch">

                                    <TextBlock Text="A"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="B"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="C"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="D"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>
                                </UniformGrid>

                                <!-- 24个料位指示灯 -->
                                <ItemsControl Grid.Row="1"
                                    Grid.Column="1"
                                    ItemsSource="{Binding MaterialSlotStatus.MaterialSlots}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="4"
                                                Columns="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="1"
                                                Padding="1"
                                                Background="White"
                                                BorderBrush="#FFE5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                ToolTip="{Binding PositionCode}">

                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                                    <!--
                                                    XAML只放置一个指示灯。
                                                    指示灯根据当前料位的State自动选择颜色。
                                                    -->
                                                    <Ellipse
                                                        Style="{StaticResource MaterialSlotIndicatorStyle}"
                                                        ToolTip="{Binding ToolTipText}"/>

                                                    <!-- 状态文字 -->
                                                    <TextBlock
                                                        Text="{Binding StatusText}"
                                                        Style="{StaticResource MaterialSlotStatusTextStyle}"/>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- 右侧：状态统计区域 -->
                        <Border Grid.Column="1"
                            Margin="6,0,0,0"
                            Padding="10"
                            Background="#FFF9FAFB"
                            BorderBrush="#FFE5E7EB"
                            BorderThickness="1"
                            CornerRadius="4">

                            <StackPanel>

                                <TextBlock
                                    Text="料位统计"
                                    Margin="0,0,0,8"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"/>

                                <!-- 总料位 -->
                                <TextBlock Margin="0,2"
                                    FontSize="14">

                                <Run Text="总料位："/>

                                <Run
                                    Text="{Binding MaterialSlotStatus.TotalSlotCount,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- 空料位 -->
                                <TextBlock Margin="0,2"
                                    FontSize="14"
                                    Foreground="#FF6B7280">

                                <Run Text="空："/>

                                <Run
                                    Text="{Binding MaterialSlotStatus.EmptySlotCount,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- 待检 -->
                                <TextBlock Margin="0,2"
                                    FontSize="14"
                                    Foreground="#FFD97706">

                                <Run Text="待检："/>

                                <Run
                                    Text="{Binding MaterialSlotStatus.WaitingSlotCount,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- 调整中 -->
                                <TextBlock Margin="0,2"
                                    FontSize="14"
                                    Foreground="#FF2563EB">

                                <Run Text="调整中："/>

                                <Run
                                    Text="{Binding MaterialSlotStatus.InspectingSlotCount,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- 合格 -->
                                <TextBlock Margin="0,2"
                                    FontSize="14"
                                    Foreground="#FF16A34A">

                                <Run Text="合格："/>

                                <Run
                                    Text="{Binding MaterialSlotStatus.QualifiedSlotCount,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- 不合格 -->
                                <TextBlock Margin="0,2"
                                    FontSize="14"
                                    Foreground="#FFDC2626">

                                <Run Text="不合格："/>

                                <Run
                                    Text="{Binding MaterialSlotStatus.UnqualifiedSlotCount,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- 人工调整 -->
                                <TextBlock Margin="0,2"
                                    FontSize="14"
                                    Foreground="#FF7C3AED">

                                <Run Text="人工调整："/>

                                <Run
                                    Text="{Binding MaterialSlotStatus.ManualAdjustingSlotCount,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- 异常 -->
                                <TextBlock Margin="0,2"
                                    FontSize="14"
                                    Foreground="#FF991B1B">

                                <Run Text="异常："/>

                                <Run
                                    Text="{Binding MaterialSlotStatus.FaultSlotCount,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                                <!-- 当前调整料位 -->
                                <TextBlock Margin="0,6,0,0"
                                    FontSize="14"
                                    Foreground="#FF2563EB">
                                <Run Text="当前调整："/>
                                <Run
                                    Text="{Binding MaterialSlotStatus.CurrentAdjustingSlotText,
                                    Mode=OneWay}"
                                    FontWeight="SemiBold"/>
                                </TextBlock>

                            </StackPanel>
                        </Border>
                    </Grid>
                </HeaderedContentControl>
                <!-- 不合格料位状态 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!--不合格料位-->

                    <HeaderedContentControl Grid.Column="0"
                    Header="不合格料位"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="1,0,0,0">

                        <!-- 不合格料位矩阵 -->
                        <Border Margin="0,0,1,0"
                                Padding="1"
                                BorderThickness="1"
                                CornerRadius="4">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 顶部列号 -->
                                    <RowDefinition Height="15"/>

                                    <!-- 指示灯矩阵 -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <!-- 左侧行号 -->
                                    <ColumnDefinition Width="15"/>

                                    <!-- 料位矩阵 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左上角空白 -->
                                <Border Grid.Row="0"
                                    Grid.Column="0"/>

                                <!-- 顶部列号：1-6 -->
                                <UniformGrid Grid.Row="0"
                                    Grid.Column="1"
                                    Rows="1"
                                    Columns="6"
                                    HorizontalAlignment="Stretch">

                                    <TextBlock Text="1"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="2"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="3"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="4"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="5"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="6"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>
                                </UniformGrid>

                                <!-- 左侧行号：A-D -->
                                <UniformGrid Grid.Row="1"
                                    Grid.Column="0"
                                    Rows="4"
                                    Columns="1"
                                    HorizontalAlignment="Stretch">

                                    <TextBlock Text="A"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="B"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="C"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="D"
                                        Style="{StaticResource SlotCoordinateTextStyle}"/>
                                </UniformGrid>

                                <!-- 24个不合格料位 -->
                                <ItemsControl Grid.Row="1"
                                    Grid.Column="1"
                                    ItemsSource=
                                    "{Binding MaterialSlotStatus.UnqualifiedMaterialSlots}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="4"
                                                Columns="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>

                                            <Border Margin="1"
                                                Padding="1"
                                                Background="White"
                                                BorderBrush="#FFE5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                ToolTip="{Binding ToolTipText}">

                                                <StackPanel
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">

                                                    <!--
                                                    只使用统一料位指示灯样式。
                                                    颜色根据State自动变化。
                                                    -->
                                                    <Ellipse
                                                        Style="{StaticResource MaterialSlotIndicatorStyle}"/>

                                                    <TextBlock
                                                        Text="{Binding StatusText}"
                                                        Style="{StaticResource MaterialSlotStatusTextStyle}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </HeaderedContentControl>

                    <!-- 缓冲料位 -->
                    <HeaderedContentControl
                        Grid.Column="1"
                        Header="缓冲料位"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1,0,0,0">

                        <!--
                        绑定MaterialSlotStatusViewModel中的缓冲料位集合。
                        XAML只定义一次显示模板，
                        ItemsControl会根据集合自动生成4个缓冲料位。
                        -->
                        <ItemsControl
                            ItemsSource="{Binding MaterialSlotStatus.BufferSlots}">

                            <!-- 四个缓冲料位垂直排列 -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>

                                    <UniformGrid
                                        Rows="4"
                                        Columns="1"/>

                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <!-- 单个缓冲料位的显示模板 -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border
                                        Margin="1"
                                        Padding="1"
                                        Background="White"
                                        BorderBrush="#FFE5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="4">

                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                            <!--
                                            料仓状态指示灯。
                                            颜色由WarehouseLevelIndicatorStyle根据
                                            当前对象的State属性自动决定。
                                            -->
                                            <Ellipse
                                                Style="{StaticResource MaterialSlotIndicatorStyle}"
                                                ToolTip="{Binding ToolTipText,
                                                Mode=OneWay}"/>

                                            <!-- 当前状态文字 -->
                                            <TextBlock
                                                Text="{Binding StatusText,
                                                               Mode=OneWay}"
                                                Style="{StaticResource MaterialSlotStatusTextStyle}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </HeaderedContentControl>
                </Grid>

            </Grid>
            <!-- 第二行第一列分为左右两部分 -->
            <Grid Grid.Row="1"
                Margin="0,1,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：料仓状态 -->
                <HeaderedContentControl
                        Grid.Column="0"
                        Header="料仓状态"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1,0,0,0">

                    <!--
                        绑定MaterialSlotStatusViewModel中的缓冲料位集合。
                        XAML只定义一次显示模板，
                        ItemsControl会根据集合自动生成4个缓冲料位。
                        -->
                    <ItemsControl
                            ItemsSource="{Binding WarehouseStatus.WarehouseLevels}">

                        <!-- 五个料仓垂直排列 -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>

                                <UniformGrid
                                        Rows="5"
                                        Columns="1"/>

                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <!-- 单个料仓的显示模板 -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Margin="1"
                                    Padding="4,1"
                                    Background="White"
                                    BorderBrush="#FFE5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="4">

                                    <Grid>
                                        <Grid.ColumnDefinitions>

                                            <!-- 左侧：层号 -->
                                            <ColumnDefinition Width="50"/>

                                            <!-- 中间：指示灯 -->
                                            <ColumnDefinition Width="Auto"/>

                                            <!-- 右侧：状态文字 -->
                                            <ColumnDefinition Width="*"/>

                                        </Grid.ColumnDefinitions>

                                        <!-- 层号 -->
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding LevelText,
                                                           Mode=OneWay}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#FF374151"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        <!-- 状态指示灯 -->
                                        <Ellipse
                                            Grid.Column="1"
                                            Style="{StaticResource WarehouseLevelIndicatorStyle}"
                                            ToolTip="{Binding ToolTipText,
                                                              Mode=OneWay}"/>

                                        <!-- 状态文字 -->
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding StatusText,
                                                           Mode=OneWay}"
                                            Style="{StaticResource WarehouseLevelStatusTextStyle}"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </HeaderedContentControl>


                <!-- 右侧：直接分为上下料轴和料仓轴 -->
                <Grid Grid.Column="1"
                    Margin="1,0,0,0">

                    <!-- 外层模板只能直接放一个内容控件，因此先放Grid -->
                    <Grid.RowDefinitions>
                        <!-- 上下料轴区域 -->
                        <RowDefinition Height="7*"/>
                        <!-- 料仓轴区域 -->
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <!-- 阻尼器上下料轴 -->
                    <HeaderedContentControl Grid.Row="0"
    Header="阻尼器上下料"
    Style="{StaticResource TitledPanelStyle}"
    Margin="0,0,0,1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <!-- 阻尼器X轴 -->
                            <controls:DataDisplayControl
            Grid.Row="0"
            Margin="0,0,0,1"
            Description="X轴(前后)位置："

            DisplayValue="{Binding
                AxisStatus.DamperXAxis.Runtime.ActualPosition,
                Mode=OneWay,
                StringFormat={}{0:+0.00;-0.00;0.00},
                FallbackValue=--,
                TargetNullValue=--}"

            Unit="{Binding
                AxisStatus.DamperXAxis.Definition.Units.Position,
                Mode=OneWay,
                FallbackValue=mm}"

            AxisStatus="{Binding
                AxisStatus.DamperXAxis.MotionStatusText,
                Mode=OneWay,
                FallbackValue=未知}"/>

                            <!-- 阻尼器Y轴 -->
                            <controls:DataDisplayControl
            Grid.Row="1"
            Margin="0,0,0,1"
            Description="Y轴(左右)位置："

            DisplayValue="{Binding
                AxisStatus.DamperYAxis.Runtime.ActualPosition,
                Mode=OneWay,
                StringFormat={}{0:+0.00;-0.00;0.00},
                FallbackValue=--,
                TargetNullValue=--}"

            Unit="{Binding
                AxisStatus.DamperYAxis.Definition.Units.Position,
                Mode=OneWay,
                FallbackValue=mm}"

            AxisStatus="{Binding
                AxisStatus.DamperYAxis.MotionStatusText,
                Mode=OneWay,
                FallbackValue=未知}"/>

                            <!-- 阻尼器Z轴 -->
                            <controls:DataDisplayControl
            Grid.Row="2"
            Margin="0,0,0,1"
            Description="Z轴(上下)位置："

            DisplayValue="{Binding
                AxisStatus.DamperZAxis.Runtime.ActualPosition,
                Mode=OneWay,
                StringFormat={}{0:+0.00;-0.00;0.00},
                FallbackValue=--,
                TargetNullValue=--}"

            Unit="{Binding
                AxisStatus.DamperZAxis.Definition.Units.Position,
                Mode=OneWay,
                FallbackValue=mm}"

            AxisStatus="{Binding
                AxisStatus.DamperZAxis.MotionStatusText,
                Mode=OneWay,
                FallbackValue=未知}"/>

                            <!-- 螺钉角度旋转轴 -->
                            <controls:DataDisplayControl
            Grid.Row="3"
            Margin="0,0,0,1"
            Description="旋转轴角度："

            DisplayValue="{Binding
                AxisStatus.DamperRotationAxis.Runtime.ActualPosition,
                Mode=OneWay,
                StringFormat={}{0:+0.00;-0.00;0.00},
                FallbackValue=--,
                TargetNullValue=--}"

            Unit="{Binding
                AxisStatus.DamperRotationAxis.Definition.Units.Position,
                Mode=OneWay,
                FallbackValue=°}"

            AxisStatus="{Binding
                AxisStatus.DamperRotationAxis.MotionStatusText,
                Mode=OneWay,
                FallbackValue=未知}"/>

                            <!-- 阻尼器夹爪轴 -->
                            <controls:DataDisplayControl
            Grid.Row="4"
            Margin="0,0,0,1"
            Description="夹爪位置："

            DisplayValue="{Binding
                AxisStatus.DamperGripperAxis.Runtime.ActualPosition,
                Mode=OneWay,
                StringFormat={}{0:+0.00;-0.00;0.00},
                FallbackValue=--,
                TargetNullValue=--}"

            Unit="{Binding
                AxisStatus.DamperGripperAxis.Definition.Units.Position,
                Mode=OneWay,
                FallbackValue=mm}"

            AxisStatus="{Binding
                AxisStatus.DamperGripperAxis.MotionStatusText,
                Mode=OneWay,
                FallbackValue=未知}"/>

                        </Grid>
                    </HeaderedContentControl>

                    <!-- 料盘上下料轴 -->
                    <HeaderedContentControl Grid.Row="1"
    Header="料盘上下料"
    Style="{StaticResource TitledPanelStyle}"
    Margin="0,1,0,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <!-- 料盘X轴 -->
                            <controls:DataDisplayControl
            Grid.Row="0"
            Margin="0,0,0,1"
            Description="X轴(前后)位置："

            DisplayValue="{Binding
                AxisStatus.TrayXAxis.Runtime.ActualPosition,
                Mode=OneWay,
                StringFormat={}{0:+0.00;-0.00;0.00},
                FallbackValue=--,
                TargetNullValue=--}"

            Unit="{Binding
                AxisStatus.TrayXAxis.Definition.Units.Position,
                Mode=OneWay,
                FallbackValue=mm}"

            AxisStatus="{Binding
                AxisStatus.TrayXAxis.MotionStatusText,
                Mode=OneWay,
                FallbackValue=未知}"/>

                            <!-- 料盘Y轴 -->
                            <controls:DataDisplayControl
            Grid.Row="1"
            Margin="0,0,0,1"
            Description="Z轴(上下)位置："

            DisplayValue="{Binding
                AxisStatus.TrayZAxis.Runtime.ActualPosition,
                Mode=OneWay,
                StringFormat={}{0:+0.00;-0.00;0.00},
                FallbackValue=--,
                TargetNullValue=--}"

            Unit="{Binding
                AxisStatus.TrayZAxis.Definition.Units.Position,
                Mode=OneWay,
                FallbackValue=mm}"

            AxisStatus="{Binding
                AxisStatus.TrayZAxis.MotionStatusText,
                Mode=OneWay,
                FallbackValue=未知}"/>

                        </Grid>
                    </HeaderedContentControl>
                </Grid>
            </Grid>
        </Grid>
        <!--中间：设备总览第二列-->
        <Grid Grid.Column="1"
            Margin="1,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <!--中间上侧实时图像显示-->
            <Grid Grid.Row="0"
                Margin="0,0,0,1">
                <HeaderedContentControl Header="螺钉角度实时检测"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="1">

                    <!-- 图像和信息面板使用同一个Grid，实现叠层显示 -->
                    <Grid Background="#FF111827"
                        ClipToBounds="True">

                        <!-- 第一层：实时图像 -->
                        <Image Source="{Binding ScrewAngleMonitor.Image}"
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

                        <!-- 尚未接入图像时的占位文字 -->
                        <TextBlock Text="实时图像"
                            FontSize="15"
                            Foreground="#FF9CA3AF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <!-- 已有图像时隐藏占位文字，避免文字覆盖实时画面。 -->
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScrewAngleMonitor.Image}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 第二层：左下角角度信息 -->
                        <Border Panel.ZIndex="10"
                            Margin="10"
                            Padding="12,8"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="#CC111827"
                            BorderBrush="#FF6B7280"
                            BorderThickness="1"
                            CornerRadius="5">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="当前角度："
                                    FontSize="15"
                                    Foreground="White"
                                    VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding ScrewAngleMonitor.CurrentAngle,
                                    StringFormat={}{0:F2}°,
                                    TargetNullValue=--,
                                    FallbackValue=--}"
                                    FontSize="15"
                                    Foreground="#FF22D3EE"
                                    VerticalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                    </Grid>
                </HeaderedContentControl>
            </Grid>
            <!--中间下侧内容-->
            <Grid Grid.Row="1"
                Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 上下料流程 -->
                <HeaderedContentControl Grid.Column="0"
                    Header="上下料流程"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="0,0,1,0">

                    <TextBox Text="{Binding LoadingProcess.Text,
                        Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        FontSize="15"
                        Padding="4"
                        BorderThickness="1"
                        BorderBrush="Gray"/>
                </HeaderedContentControl>

                <!-- 调整流程 -->
                <HeaderedContentControl Grid.Column="1"
                    Header="同轴度调整流程"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="1,0,0,0">

                    <TextBox Text="{Binding AdjustmentProcess.Text,
                        Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        FontSize="15"
                        Padding="4"
                        BorderThickness="1"
                        BorderBrush="Gray"/>
                </HeaderedContentControl>
            </Grid>
        </Grid>
        <!--右侧：设备总览第三列-->
        <Grid Grid.Column="2"
            Margin="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <!--第三列上侧实时图像显示-->
            <Grid Grid.Row="0"
                Margin="0,0,0,1">
                <HeaderedContentControl Header="同轴度实时检测"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="1">

                    <Grid Background="#FF111827"
                        ClipToBounds="True">

                        <!-- 第一层：实时检测图像 -->
                        <Image Source="{Binding CoaxialityMonitor.Image}"
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

                        <!-- 暂未接入图像时的占位文字 -->
                        <TextBlock Text="实时图像"
                            FontSize="16"
                            Foreground="#FF9CA3AF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <!-- 已有图像时隐藏占位文字，避免文字覆盖实时画面。 -->
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CoaxialityMonitor.Image}"
                                            Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 第二层：底部同轴度数据 -->
                        <Border Panel.ZIndex="10"
                            Margin="10"
                            Padding="8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="#CC111827"
                            BorderBrush="#FF6B7280"
                            BorderThickness="1"
                            CornerRadius="5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 第一列：X偏差 -->
                                <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="X偏差："
                                        FontSize="15"
                                        Foreground="#FFD1D5DB"
                                        VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding CoaxialityMonitor.XDeviation,
                                        StringFormat={}{0:F3} mm,
                                        TargetNullValue=--,
                                        FallbackValue=--}"
                                        FontSize="15"
                                        Foreground="White"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 第二列：Y偏差 -->
                                <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="Y偏差："
                                        FontSize="15"
                                        Foreground="#FFD1D5DB"
                                        VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding CoaxialityMonitor.YDeviation,
                                        StringFormat={}{0:F3} mm,
                                        TargetNullValue=--,
                                        FallbackValue=--}"
                                        FontSize="15"
                                        Foreground="White"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 第三列：同轴度 -->
                                <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="同轴度："
                                        FontSize="15"
                                        Foreground="#FFD1D5DB"
                                        VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding CoaxialityMonitor.Coaxiality,
                                        StringFormat={}{0:F3} mm,
                                        TargetNullValue=--,
                                        FallbackValue=--}"
                                        FontSize="15"
                                        Foreground="#FF22D3EE"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 第四列：合格判定 -->
                                <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="是否合格："
                                        FontSize="15"
                                        Foreground="#FFD1D5DB"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        DataContext="{Binding CoaxialityMonitor}"
                                        Style="{StaticResource QualificationResultTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </HeaderedContentControl>
            </Grid>
            <!--第三列下侧内容-->
            <Grid Grid.Row="1"
                Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45*"/>
                    <ColumnDefinition Width="55*"/>
                </Grid.ColumnDefinitions>
                <!--右下角第一列-->
                <Grid Grid.Column="0"
                    Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <!-- 夹紧轴数据 -->
                    <HeaderedContentControl Grid.Row="0"
                        Header="夹紧轴"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <!-- 夹紧轴位置 -->
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,1,0,0"
                                Description="夹紧轴位置："

                                DisplayValue="{Binding
                                    AxisStatus.ClampingAxis.Runtime.ActualPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:+0.00;-0.00;0.00},
                                    FallbackValue=--,
                                    TargetNullValue=--}"

                                Unit="{Binding
                                    AxisStatus.ClampingAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=mm}"

                                AxisStatus="{Binding
                                    AxisStatus.ClampingAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=未知}"/>

                            <!-- 夹紧轴力矩 -->
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,0"
                                Description="夹紧轴力矩："

                                DisplayValue="{Binding
                                    AxisStatus.ClampingAxis.Runtime.ActualTorque,
                                    Mode=OneWay,
                                    StringFormat={}{0:F2},
                                    FallbackValue=--,
                                    TargetNullValue=--}"

                                Unit="{Binding
                                    AxisStatus.ClampingAxis.Definition.Units.Torque,
                                    Mode=OneWay,
                                    FallbackValue=N·m}"

                                AxisStatus="{Binding
                                    AxisStatus.ClampingAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=未知}"/>

                            <!--
                            补偿位移不属于夹紧轴标准实时数据。
                            在CoaxialityMonitorViewModel增加相应属性之前先显示“null”。
                            -->
                            <controls:DataDisplayControl
                                Grid.Row="2"
                                Margin="0,1,0,0"
                                Description="补偿位移："
                                DisplayValue="--"
                                Unit="μm"
                                AxisStatus="--"/>

                        </Grid>
                    </HeaderedContentControl>
                    <!--转台轴数据-->
                    <HeaderedContentControl Grid.Row="1"
                        Header="转台轴"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="转台轴角度："

                                DisplayValue="{Binding
                                    AxisStatus.TurntableAxis.Runtime.ActualPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:+0.00;-0.00;0.00},
                                    FallbackValue=--,
                                    TargetNullValue=--}"

                                Unit="{Binding
                                    AxisStatus.TurntableAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=°}"

                                AxisStatus="{Binding
                                    AxisStatus.TurntableAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=未知}"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                    Text="备料位："
                                    FontSize="15"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="1"
                                    Text="ZNQ_2026_08_20"
                                    FontSize="15"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                    Text="调整位："
                                    FontSize="15"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="1"
                                    Text="ZNQ_2026_08_19"
                                    FontSize="15"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"/>
                            </Grid>
                        </Grid>
                    </HeaderedContentControl>

                </Grid>

                <!--右下角第二列-->
                <Grid Grid.Column="1"
                    Margin="0,0,0,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <!-- 螺丝刀轴数据 -->
                    <HeaderedContentControl Grid.Row="0"
                        Header="螺丝刀轴"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <!-- 螺丝刀Y轴 -->
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="Y轴(左右)位置："

                                DisplayValue="{Binding
                                    AxisStatus.ScrewdriverYAxis.Runtime.ActualPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:+0.00;-0.00;0.00},
                                    FallbackValue=--,
                                    TargetNullValue=--}"

                                Unit="{Binding
                                    AxisStatus.ScrewdriverYAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=mm}"

                                AxisStatus="{Binding
                                    AxisStatus.ScrewdriverYAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=未知}"/>

                            <!-- 螺丝刀Z轴 -->
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,0"
                                Description="Z轴(上下)位置："

                                DisplayValue="{Binding
                                    AxisStatus.ScrewdriverZAxis.Runtime.ActualPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:+0.00;-0.00;0.00},
                                    FallbackValue=--,
                                    TargetNullValue=--}"

                                Unit="{Binding
                                    AxisStatus.ScrewdriverZAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=mm}"

                                AxisStatus="{Binding
                                    AxisStatus.ScrewdriverZAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=未知}"/>

                        </Grid>
                    </HeaderedContentControl>
                    <!-- 同轴度调整轴数据 -->
                    <HeaderedContentControl Grid.Row="1"
                        Header="调整轴"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <!-- 调整X轴 -->
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,2,0,1"
                                Description="X轴(前后)位置："

                                DisplayValue="{Binding
                                    AxisStatus.AdjustmentXAxis.Runtime.ActualPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:+0.00;-0.00;0.00},
                                    FallbackValue=--,
                                    TargetNullValue=--}"

                                Unit="{Binding
                                    AxisStatus.AdjustmentXAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=mm}"

                                AxisStatus="{Binding
                                    AxisStatus.AdjustmentXAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=未知}"/>

                            <!-- 调整Y轴 -->
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,1"
                                Description="Y轴(左右)位置："

                                DisplayValue="{Binding
                                    AxisStatus.AdjustmentYAxis.Runtime.ActualPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:+0.00;-0.00;0.00},
                                    FallbackValue=--,
                                    TargetNullValue=--}"

                                Unit="{Binding
                                    AxisStatus.AdjustmentYAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=mm}"

                                AxisStatus="{Binding
                                    AxisStatus.AdjustmentYAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=未知}"/>

                            <!-- 调整Z轴 -->
                            <controls:DataDisplayControl
                                Grid.Row="2"
                                Margin="0,1,0,2"
                                Description="Z轴(上下)位置："

                                DisplayValue="{Binding
                                    AxisStatus.AdjustmentZAxis.Runtime.ActualPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:+0.00;-0.00;0.00},
                                    FallbackValue=--,
                                    TargetNullValue=--}"

                                Unit="{Binding
                                    AxisStatus.AdjustmentZAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=mm}"

                                AxisStatus="{Binding
                                    AxisStatus.AdjustmentZAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=未知}"/>

                        </Grid>
                    </HeaderedContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
