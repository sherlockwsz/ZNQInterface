<UserControl x:Class="ZNQInterface.Views.Pages.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZNQInterface.Views.Pages"
    xmlns:controls="clr-namespace:ZNQInterface.Controls"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

        <!-- 料位矩阵行号、列号样式 -->
        <Style x:Key="SlotCoordinateTextStyle"
           TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="Foreground"
                Value="#FF374151"/>

            <Setter Property="HorizontalAlignment"
                Value="Center"/>

            <Setter Property="VerticalAlignment"
                Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!--左侧：设备总览第一列-->
        <Grid Grid.Column="0"
            Margin="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <!--第一行第一列分为上下两部分-->
            <Grid Grid.Row="0"
                Margin="0,0,0,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!--料位状态-->
                <HeaderedContentControl Style="{StaticResource TitledPanelStyle}">
                    <!-- 自定义标题栏 -->
                    <HeaderedContentControl.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧标题 -->
                            <TextBlock Grid.Column="0"
                       Text="料位状态"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="Black"
                       VerticalAlignment="Center"/>

                            <!-- 右侧当前调整层 -->
                            <TextBlock Grid.Column="1"
                       Margin="12,0,4,0"
                       FontSize="14"
                       FontWeight="Normal"
                       Foreground="Black"
                       VerticalAlignment="Center">

                <Run Text="当前调整：第3"/>
                <Run Text="{Binding CurrentAdjustmentLayer,
                                    Mode=OneWay}"/>
                <Run Text="层"/>
                            </TextBlock>
                        </Grid>
                    </HeaderedContentControl.Header>
                    <!-- 料位状态主体：左侧料位矩阵，右侧信息区 -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <!-- 左侧占80% -->
                            <ColumnDefinition Width="4*"/>

                            <!-- 右侧占20% -->
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：A-D、1-6料位矩阵 -->
                        <Border Grid.Column="0"
                Margin="0,0,1,0"
                Padding="1"
                BorderThickness="1"
                CornerRadius="4">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 顶部列号 -->
                                    <RowDefinition Height="15"/>

                                    <!-- 指示灯区域 -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <!-- 左侧行号 -->
                                    <ColumnDefinition Width="15"/>

                                    <!-- 料位矩阵 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左上角空白区域 -->
                                <Border Grid.Row="0"
                        Grid.Column="0"/>

                                <!-- 顶部列号：1-6 -->
                                <UniformGrid Grid.Row="0"
                             Grid.Column="1"
                             Rows="1"
                             Columns="6"
                            HorizontalAlignment="Stretch">

                                    <TextBlock Text="1"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="2"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="3"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="4"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="5"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="6"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>
                                </UniformGrid>

                                <!-- 左侧行号：A-D -->
                                <UniformGrid Grid.Row="1"
                             Grid.Column="0"
                             Rows="4"
                             Columns="1"
                             HorizontalAlignment="Stretch">

                                    <TextBlock Text="A"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="B"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="C"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="D"
                               Style="{StaticResource SlotCoordinateTextStyle}"/>
                                </UniformGrid>

                                <!-- 24个料位指示灯 -->
                                <ItemsControl Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding MaterialSlots}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="4"
                                         Columns="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="1"
                                    Padding="1"
                                    Background="White"
                                    BorderBrush="#FFE5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ToolTip="{Binding PositionCode}">

                                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                                    <!-- 状态指示灯 -->
                                                    <Ellipse Width="24"
         Height="24"
         StrokeThickness="2">

                                                        <Ellipse.Style>
                                                            <Style TargetType="{x:Type Ellipse}">
                                                                <Setter Property="Fill"
                    Value="#FF22C55E"/>

                                                                <Setter Property="Stroke"
                    Value="#FF15803D"/>

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsQualified}"
                             Value="False">
                                                                        <Setter Property="Fill"
                            Value="#FFEF4444"/>

                                                                        <Setter Property="Stroke"
                            Value="#FFB91C1C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <!-- 指示灯下方状态文字 -->
                                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding StatusText}"
                                               FontSize="12"
                                               Foreground="#FF374151"
                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- 右侧：状态统计区域 -->
                        <Border Grid.Column="1"
                Margin="6,0,0,0"
                Padding="10"
                Background="#FFF9FAFB"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="4">

                            <StackPanel>
                                <TextBlock Text="料位统计"
                           Margin="0,0,0,12"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                                <TextBlock Text="总料位:24"
                           Margin="0,4"
                           FontSize="14"/>

                                <TextBlock Text="合格:24"
                           Margin="0,4"
                           FontSize="14"
                           Foreground="#FF16A34A"/>

                                <TextBlock Text="不合格:0"
                           Margin="0,4"
                           FontSize="14"
                           Foreground="#FFDC2626"/>

                                <TextBlock Text="当前调整:1-A5"
                           Margin="0,4"
                           FontSize="14"
                           Foreground="Blue"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </HeaderedContentControl>
                <!-- 不合格料位状态 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!--不合格料位-->

                    <HeaderedContentControl Grid.Column="0"
                    Header="不合格料位"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="1,0,0,0">

                        <!-- 不合格料位矩阵 -->
                        <Border Margin="0,0,1,0"
        Padding="1"
        BorderThickness="1"
        CornerRadius="4">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 顶部列号 -->
                                    <RowDefinition Height="15"/>

                                    <!-- 指示灯矩阵 -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <!-- 左侧行号 -->
                                    <ColumnDefinition Width="15"/>

                                    <!-- 料位矩阵 -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左上角空白 -->
                                <Border Grid.Row="0"
                Grid.Column="0"/>

                                <!-- 顶部列号：1-6 -->
                                <UniformGrid Grid.Row="0"
                        Grid.Column="1"
                        Rows="1"
                        Columns="6"
                        HorizontalAlignment="Stretch">

                                    <TextBlock Text="1"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="2"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="3"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="4"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="5"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="6"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>
                                </UniformGrid>

                                <!-- 左侧行号：A-D -->
                                <UniformGrid Grid.Row="1"
                        Grid.Column="0"
                        Rows="4"
                        Columns="1"
                        HorizontalAlignment="Stretch">

                                    <TextBlock Text="A"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="B"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="C"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>

                                    <TextBlock Text="D"
                        Style="{StaticResource SlotCoordinateTextStyle}"/>
                                </UniformGrid>

                                <!-- 24个不合格料位 -->
                                <ItemsControl Grid.Row="1"
                        Grid.Column="1"
                        ItemsSource="{Binding UnqualifiedMaterialSlots}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="4"
                                    Columns="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="1"
                            Padding="1"
                            Background="White"
                            BorderBrush="#FFE5E7EB"
                            BorderThickness="1"
                            CornerRadius="4"
                            ToolTip="{Binding PositionCode}">

                                                <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                                    <!-- 不合格状态指示灯 -->
                                                    <Ellipse Width="24"
                                        Height="24"
                                        StrokeThickness="2">

                                                        <Ellipse.Style>
                                                            <Style TargetType="{x:Type Ellipse}">
                                                                <!-- 默认绿色 -->
                                                                <Setter Property="Fill"
                                                Value="#FF22C55E"/>

                                                                <Setter Property="Stroke"
                                                Value="#FF15803D"/>

                                                                <Style.Triggers>
                                                                    <!-- 不合格显示红色 -->
                                                                    <DataTrigger Binding="{Binding IsQualified}"
                                                            Value="False">
                                                                        <Setter Property="Fill"
                                                        Value="#FFEF4444"/>

                                                                        <Setter Property="Stroke"
                                                        Value="#FFB91C1C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <!-- 指示灯下方状态文字 -->
                                                    <TextBlock Margin="0,4,0,0"
                                        Text="{Binding StatusText}"
                                        FontSize="12"
                                        Foreground="#FF374151"
                                        HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </HeaderedContentControl>


                    <!-- 缓冲料位 -->
                    <HeaderedContentControl Grid.Column="1"
                        Header="缓冲料位"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1,0,0,0">

                        <!-- 四个缓冲料位垂直排列 -->
                        <UniformGrid Rows="4"
                 Columns="1">

                            <!-- 缓冲料位1 -->
                            <Border Margin="1"
                Padding="1"
                Background="White"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="4">

                                <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Ellipse Width="24"
                         Height="24"
                         Fill="#FF22C55E"
                         Stroke="#FF15803D"
                         StrokeThickness="2"/>

                                    <TextBlock Margin="0,4,0,0"
                           Text="合格"
                           FontSize="12"
                           Foreground="#FF374151"
                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 缓冲料位2 -->
                            <Border Margin="1"
                Padding="1"
                Background="White"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="4">

                                <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Ellipse Width="24"
                         Height="24"
                         Fill="Gray"
                         Stroke="Gray"
                         StrokeThickness="2"/>

                                    <TextBlock Margin="0,4,0,0"
                           Text="空"
                           FontSize="12"
                           Foreground="#FF374151"
                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 缓冲料位3 -->
                            <Border Margin="1"
                Padding="1"
                Background="White"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="4">

                                <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Ellipse Width="24"
                         Height="24"
                         Fill="Gray"
                         Stroke="Gray"
                         StrokeThickness="2"/>

                                    <TextBlock Margin="0,4,0,0"
                           Text="空"
                           FontSize="12"
                           Foreground="#FF374151"
                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 缓冲料位4 -->
                            <Border Margin="1"
                Padding="1"
                Background="White"
                BorderBrush="#FFE5E7EB"
                BorderThickness="1"
                CornerRadius="4">

                                <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                                    <Ellipse Width="24"
                         Height="24"
                         Fill="Gray"
                         Stroke="Gray"
                         StrokeThickness="2"/>

                                    <TextBlock Margin="0,4,0,0"
                           Text="空"
                           FontSize="12"
                           Foreground="#FF374151"
                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </HeaderedContentControl>
                </Grid>

            </Grid>
            <!-- 第二行第一列分为左右两部分 -->
            <Grid Grid.Row="1"
                Margin="0,1,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：料仓状态 -->
                <HeaderedContentControl Grid.Column="0"
                    Header="料仓状态"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="0,0,1,0">

                    <!-- 五层料仓状态 -->
                    <Grid Margin="1">

                        <Grid.RowDefinitions>
                            <!-- 最上层：第五层 -->
                            <RowDefinition Height="1*"/>

                            <!-- 第四层 -->
                            <RowDefinition Height="1*"/>

                            <!-- 第三层 -->
                            <RowDefinition Height="1*"/>

                            <!-- 第二层 -->
                            <RowDefinition Height="1*"/>

                            <!-- 最下层：第一层 -->
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- 第五层：已调整 -->
                        <Border Grid.Row="0"
            Margin="1"
            Padding="4,1"
            Background="White"
            BorderBrush="#FF22C55E"
            BorderThickness="1"
            CornerRadius="4">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- 层号 -->
                                    <ColumnDefinition Width="30"/>

                                    <!-- 指示灯 -->
                                    <ColumnDefinition Width="Auto"/>

                                    <!-- 状态文字 -->
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                       Text="五层"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FF374151"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="1"
                     Width="24"
                     Height="24"
                     Margin="8,0"
                     Fill="#FF22C55E"
                     Stroke="#FF22C55E"
                     StrokeThickness="2"
                     VerticalAlignment="Center"
                                         HorizontalAlignment="Left"/>

                                <TextBlock Grid.Column="2"
                       Text="已调整"
                       FontSize="13"
                       Foreground="#FF16A34A"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 第四层：已调整 -->
                        <Border Grid.Row="1"
            Margin="1"
            Padding="4,1"
            Background="White"
            BorderBrush="#FF22C55E"
            BorderThickness="1"
            CornerRadius="4">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                       Text="四层"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FF374151"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="1"
                     Width="24"
                     Height="24"
                     Margin="8,0"
                     Fill="#FF22C55E"
                     Stroke="#FF22C55E"
                     StrokeThickness="2"
                     VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                       Text="已调整"
                       FontSize="13"
                       Foreground="#FF16A34A"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 第三层：调整中 -->
                        <Border Grid.Row="2"
            Margin="1"
            Padding="4,1"
            Background="White"
            BorderBrush="#FF3B82F6"
            BorderThickness="1"
            CornerRadius="4">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                       Text="三层"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FF374151"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="1"
                     Width="24"
                     Height="24"
                     Margin="8,0"
                     Fill="#FF3B82F6"
                     Stroke="#FF3B82F6"
                     StrokeThickness="2"
                     VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                       Text="调整中"
                       FontSize="13"
                       Foreground="#FF2563EB"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 第二层：未调整 -->
                        <Border Grid.Row="3"
            Margin="1"
            Padding="4,1"
            Background="White"
            BorderBrush="#FFF59E0B"
            BorderThickness="1"
            CornerRadius="4">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                       Text="二层"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FF374151"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="1"
                     Width="24"
                     Height="24"
                     Margin="8,0"
                     Fill="#FFF59E0B"
                     Stroke="#FFF59E0B"
                     StrokeThickness="2"
                     VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                       Text="未调整"
                       FontSize="13"
                       Foreground="#FFD97706"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 第一层：未调整，位于最下方 -->
                        <Border Grid.Row="4"
            Margin="1"
            Padding="4,1"
            Background="White"
            BorderBrush="#FFF59E0B"
            BorderThickness="1"
            CornerRadius="4">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                       Text="一层"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#FF374151"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="1"
                     Width="24"
                     Height="24"
                     Margin="8,0"
                     Fill="#FFF59E0B"
                     Stroke="#FFF59E0B"
                     StrokeThickness="2"
                     VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                       Text="未调整"
                       FontSize="13"
                       Foreground="#FFD97706"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                </HeaderedContentControl>

                <!-- 右侧：直接分为上下料轴和料仓轴 -->
                <Grid Grid.Column="1"
                    Margin="1,0,0,0">

                    <!-- 外层模板只能直接放一个内容控件，因此先放Grid -->
                    <Grid.RowDefinitions>
                        <!-- 上下料轴区域 -->
                        <RowDefinition Height="7*"/>
                        <!-- 料仓轴区域 -->
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <!-- 上下料轴 -->
                    <HeaderedContentControl Grid.Row="0"
                        Header="阻尼器上下料"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="X轴(前后)位置："
                                DisplayValue="+125.36"
                                Unit="mm"
                                AxisStatus="前移"/>
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,0,0,1"
                                Description="Y轴(左右)位置："
                                DisplayValue="+205.36"
                                Unit="mm"
                                AxisStatus="左移"/>
                            <controls:DataDisplayControl
                                Grid.Row="2"
                                Margin="0,0,0,1"
                                Description="Z轴(上下)位置："
                                DisplayValue="+489.36"
                                Unit="mm"
                                AxisStatus="到位"/>
                            <controls:DataDisplayControl
                                Grid.Row="3"
                                Margin="0,0,0,1"
                                Description="夹爪角度："
                                DisplayValue="+47.68"
                                Unit="°"
                                AxisStatus="正转"/>
                            <controls:DataDisplayControl
                                Grid.Row="4"
                                Margin="0,0,0,1"
                                Description="夹爪状态："
                                DisplayValue="+16.87"
                                Unit="mm"
                                AxisStatus="松开"/>
                        </Grid>
                    </HeaderedContentControl>
                    <!-- 料仓轴 -->
                    <HeaderedContentControl Grid.Row="1"
                        Header="料盘上下料"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="X轴(前后)位置："
                                DisplayValue="+289.87"
                                Unit="mm"
                                AxisStatus="后移"/>

                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,0,0,1"
                                Description="Z轴(上下)位置："
                                DisplayValue="+756.45"
                                Unit="mm"
                                AxisStatus="上移"/>
                        </Grid>
                    </HeaderedContentControl>
                </Grid>
            </Grid>
        </Grid>
        <!--中间：设备总览第二列-->
        <Grid Grid.Column="1"
            Margin="1,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <!--中间上侧实时图像显示-->
            <Grid Grid.Row="0"
                Margin="0,0,0,1">
                <HeaderedContentControl Header="螺钉角度实时检测"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="1">

                    <!-- 图像和信息面板使用同一个Grid，实现叠层显示 -->
                    <Grid Background="#FF111827"
                        ClipToBounds="True">

                        <!-- 第一层：实时图像 -->
                        <Image Source="{Binding ScrewAngleImage.Image}"
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

                        <!-- 尚未接入图像时的占位文字 -->
                        <TextBlock Text="实时图像"
                            FontSize="15"
                            Foreground="#FF9CA3AF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <!-- 第二层：左下角角度信息 -->
                        <Border Panel.ZIndex="10"
                            Margin="10"
                            Padding="12,8"
                            MinWidth="160"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="#CC111827"
                            BorderBrush="#FF6B7280"
                            BorderThickness="1"
                            CornerRadius="5">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="当前角度："
                                    FontSize="15"
                                    Foreground="White"
                                    VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding ScrewAngleMonitor.CurrentAngle,
                                    StringFormat={}{0:F2}°,
                                    TargetNullValue=--,
                                    FallbackValue=--}"
                                    FontSize="15"
                                    Foreground="#FF22D3EE"
                                    VerticalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                    </Grid>
                </HeaderedContentControl>
            </Grid>
            <!--中间下侧内容-->
            <Grid Grid.Row="1"
                Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 上下料流程 -->
                <HeaderedContentControl Grid.Column="0"
                    Header="上下料流程"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="0,0,1,0">

                    <TextBox Text="{Binding LoadingProcessText}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        FontSize="15"
                        Padding="4"
                        BorderThickness="1"
                        BorderBrush="Gray"/>
                </HeaderedContentControl>

                <!-- 调整流程 -->
                <HeaderedContentControl Grid.Column="1"
                    Header="同轴度调整流程"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="1,0,0,0">

                    <TextBox Text="{Binding AdjustmentProcessText}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        FontSize="15"
                        Padding="4"
                        BorderThickness="1"
                        BorderBrush="Gray"/>
                </HeaderedContentControl>
            </Grid>
        </Grid>
        <!--右侧：设备总览第三列-->
        <Grid Grid.Column="2"
            Margin="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <!--第三列上侧实时图像显示-->
            <Grid Grid.Row="0"
                Margin="0,0,0,1">
                <HeaderedContentControl Header="同轴度实时检测"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="1">

                    <Grid Background="#FF111827"
                        ClipToBounds="True">

                        <!-- 第一层：实时检测图像 -->
                        <Image Source="{Binding CoaxialityMonitor.Image}"
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

                        <!-- 暂未接入图像时的占位文字 -->
                        <TextBlock Text="实时图像"
                            FontSize="16"
                            Foreground="#FF9CA3AF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <!-- 第二层：底部同轴度数据 -->
                        <Border Panel.ZIndex="10"
                            Margin="10"
                            Padding="8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="#CC111827"
                            BorderBrush="#FF6B7280"
                            BorderThickness="1"
                            CornerRadius="5">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 第一列：X偏差 -->
                                <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="X偏差："
                                        FontSize="15"
                                        Foreground="#FFD1D5DB"
                                        VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding CoaxialityMonitor.XDeviation,
                                        StringFormat={}{0:F3} mm,
                                        TargetNullValue=--,
                                        FallbackValue=--}"
                                        FontSize="15"
                                        Foreground="White"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 第二列：Y偏差 -->
                                <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="Y偏差："
                                        FontSize="15"
                                        Foreground="#FFD1D5DB"
                                        VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding CoaxialityMonitor.YDeviation,
                                        StringFormat={}{0:F3} mm,
                                        TargetNullValue=--,
                                        FallbackValue=--}"
                                        FontSize="15"
                                        Foreground="White"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 第三列：同轴度 -->
                                <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="同轴度："
                                        FontSize="15"
                                        Foreground="#FFD1D5DB"
                                        VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding CoaxialityMonitor.Coaxiality,
                                        StringFormat={}{0:F3} mm,
                                        TargetNullValue=--,
                                        FallbackValue=--}"
                                        FontSize="15"
                                        Foreground="#FF22D3EE"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 第四列：合格判定 -->
                                <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                    <TextBlock Text="是否合格："
                                        FontSize="15"
                                        Foreground="#FFD1D5DB"
                                        VerticalAlignment="Center"/>

                                    <TextBlock FontSize="15"
                                        VerticalAlignment="Center">

                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">

                                                <!-- 尚未判定 -->
                                                <Setter Property="Text" Value="--"/>
                                                <Setter Property="Foreground" Value="#FF9CA3AF"/>

                                                <Style.Triggers>

                                                    <!-- 合格 -->
                                                    <DataTrigger Binding="{Binding CoaxialityMonitor.IsQualified}"
                                                        Value="True">
                                                        <Setter Property="Text" Value="合格"/>
                                                        <Setter Property="Foreground" Value="#FF4ADE80"/>
                                                    </DataTrigger>

                                                    <!-- 不合格 -->
                                                    <DataTrigger Binding="{Binding CoaxialityMonitor.IsQualified}"
                                                        Value="False">
                                                        <Setter Property="Text" Value="不合格"/>
                                                        <Setter Property="Foreground" Value="#FFF87171"/>
                                                    </DataTrigger>

                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                </HeaderedContentControl>
            </Grid>
            <!--第三列下侧内容-->
            <Grid Grid.Row="1"
                Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <!--右下角第一列-->
                <Grid Grid.Column="0"
                    Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <!--夹紧轴数据-->
                    <HeaderedContentControl Grid.Row="0"
                        Header="夹紧轴"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <!--夹紧轴位置-->
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,1,0,0"
                                Description="夹紧轴位置："
                                DisplayValue="-456.45"
                                Unit="mm"
                                AxisStatus="夹紧"/>
                            <!--夹紧轴力矩-->
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,0"
                                Description="夹紧轴力矩："
                                DisplayValue="1.00"
                                Unit="N·m"
                                AxisStatus="夹紧"/>
                            <!--补偿位移-->
                            <controls:DataDisplayControl
                                Grid.Row="2"
                                Margin="0,1,0,0"
                                Description="补偿位移："
                                DisplayValue="1.00"
                                Unit="μm"/>

                        </Grid>

                    </HeaderedContentControl>
                    <!--转台轴数据-->
                    <HeaderedContentControl Grid.Row="1"
                        Header="转台轴"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="转台轴角度："
                                DisplayValue="-180.00"
                                Unit="°"
                                AxisStatus="反转"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                    Text="备料位："
                                    FontSize="15"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="1"
                                    Text="ZNQ_2026_08_20"
                                    FontSize="15"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                    Text="调整位："
                                    FontSize="15"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="1"
                                    Text="ZNQ_2026_08_19"
                                    FontSize="15"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"/>
                            </Grid>
                        </Grid>
                    </HeaderedContentControl>

                </Grid>

                <!--右下角第二列-->
                <Grid Grid.Column="1"
                    Margin="0,0,0,1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <!--螺丝刀轴数据-->
                    <HeaderedContentControl Grid.Row="0"
                        Header="螺丝刀轴"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,0,0,1"
                                Description="Y(左右)轴："
                                DisplayValue="+176.78"
                                Unit="mm"
                                AxisStatus="左移"/>
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,0"
                                Description="Z(上下)轴："
                                DisplayValue="+201.45"
                                Unit="mm"
                                AxisStatus="下移"/>
                        </Grid>
                    </HeaderedContentControl>

                    <!--调整轴数据-->
                    <HeaderedContentControl Grid.Row="1"
                        Header="调整轴"
                        Style="{StaticResource TitledPanelStyle}"
                        Margin="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <!--调整轴X-->
                            <controls:DataDisplayControl
                                Grid.Row="0"
                                Margin="0,2,0,1"
                                Description="X(前后)轴："
                                DisplayValue="+675.78"
                                Unit="mm"
                                AxisStatus="到位"/>
                            <!--调整轴Y-->
                            <controls:DataDisplayControl
                                Grid.Row="1"
                                Margin="0,1,0,1"
                                Description="Y(左右)轴："
                                DisplayValue="+715.98"
                                Unit="mm"
                                AxisStatus="右移"/>
                            <!--调整轴Z-->
                            <controls:DataDisplayControl
                                Grid.Row="2"
                                Margin="0,1,0,1"
                                Description="Z(上下)轴："
                                DisplayValue="+487.45"
                                Unit="mm"
                                AxisStatus="下移"/>
                            <!--调整轴夹爪-->
                            <controls:DataDisplayControl
                                Grid.Row="3"
                                Margin="0,1,0,2"
                                Description="夹爪："
                                DisplayValue="+123.45"
                                Unit="mm"
                                AxisStatus="夹紧"/>
                        </Grid>
                    </HeaderedContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
