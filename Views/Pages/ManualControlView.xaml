<UserControl x:Class="ZNQInterface.Views.Pages.ManualControlView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZNQInterface.Views.Pages"
    xmlns:controls="clr-namespace:ZNQInterface.Controls"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--
        相对运动命令需要double类型参数。
        使用资源可以避免CommandParameter="1"被当成字符串。
        -->
        <sys:Double x:Key="PositiveDirectionFactor">1</sys:Double>
        <sys:Double x:Key="NegativeDirectionFactor">-1</sys:Double>

        <Style x:Key="AxisDetailCellStyle"
            TargetType="{x:Type Border}">

            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <!-- 当前调试轴内部三个功能区的公共边框样式。 -->
        <Style x:Key="CurrentDebugSectionBorderStyle"
            TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="#FFF9FAFB"/>
            <Setter Property="BorderBrush" Value="#FFE5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- 当前调试轴参数名称样式。 -->
        <Style x:Key="CurrentDebugParameterLabelStyle"
            TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 当前调试轴参数输入框样式。 -->
        <Style x:Key="CurrentDebugParameterTextBoxStyle"
            TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!--
轴列表样式：

1. UniformGrid把轴卡片平均布置在整个轴组区域；
2. 每张轴卡片固定为108像素；
3. 当轴数量较少时，多余空间自动分配到卡片周围；
4. 所有列的轴卡片大小保持一致。
-->
        <Style x:Key="AxisListBoxStyle"
    TargetType="{x:Type ListBox}">

            <Setter Property="Background"
        Value="Transparent"/>

            <Setter Property="BorderThickness"
        Value="0"/>

            <Setter Property="Padding"
        Value="2"/>

            <Setter Property="HorizontalContentAlignment"
        Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
        Value="Center"/>

            <!--
    关闭纵向滚动，使UniformGrid获得ListBox的完整高度。
    当前界面按1920×1080全屏设计，空间足够。
    -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
        Value="Disabled"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
        Value="Disabled"/>

            <Setter Property="ScrollViewer.CanContentScroll"
        Value="False"/>

            <!--
    一列多行。
    行数根据当前轴组的轴数量自动计算。
    -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ListBoxItem}">

                        <!-- 所有轴卡片保持相同高度 -->
                        <Setter Property="Height"
                    Value="108"/>

                        <!-- 左右边距固定，纵向间隙主要由UniformGrid分配 -->
                        <Setter Property="Margin"
                    Value="2"/>

                        <Setter Property="Padding"
                    Value="0"/>

                        <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

                        <!-- 卡片在UniformGrid分配的单元格中垂直居中 -->
                        <Setter Property="VerticalAlignment"
                    Value="Center"/>

                        <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

                        <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate
                            TargetType="{x:Type ListBoxItem}">

                                    <Border x:Name="SelectedBorder"
                                Background="White"
                                BorderBrush="#FFD1D5DB"
                                BorderThickness="3"
                                CornerRadius="5">

                                        <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <!-- 鼠标经过 -->
                                        <Trigger Property="IsMouseOver"
                                    Value="True">

                                            <Setter
                                        TargetName="SelectedBorder"
                                        Property="Background"
                                        Value="#FFEFF6FF"/>

                                        </Trigger>

                                        <!-- 当前选中轴 -->
                                        <Trigger Property="IsSelected"
                                    Value="True">

                                            <Setter
                                        TargetName="SelectedBorder"
                                        Property="Background"
                                        Value="#FFDBEAFE"/>

                                            <Setter
                                        TargetName="SelectedBorder"
                                        Property="BorderBrush"
                                        Value="#FF2563EB"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 单根轴数据显示模板 -->
        <DataTemplate x:Key="AxisItemTemplate">

            <Border
        Padding="8,4"
        Background="White"
        BorderBrush="#FFD1D5DB"
        BorderThickness="1"
        CornerRadius="4"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

                <Grid>

                    <Grid.RowDefinitions>
                        <!-- 第一行：轴名称和运动状态 -->
                        <RowDefinition Height="24"/>

                        <!-- 第二、三行：数据显示 -->
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>

                        <!-- 第四行：状态显示 -->
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：轴名称和运动状态 -->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                    Text="{Binding Definition.DisplayName,
                           Mode=OneWay}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#FF1F2937"
                    VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                    Text="{Binding MotionStatusText,
                           Mode=OneWay,
                           FallbackValue=未知}"
                    FontSize="14"
                    Foreground="#FF2563EB"
                    VerticalAlignment="Center"/>

                    </Grid>

                    <!-- 第二、三行：实际数据和设定数据 -->
                    <Grid Grid.Row="1"
                Grid.RowSpan="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="24"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 实际位置 -->
                        <TextBlock Grid.Row="0"
                    Grid.Column="0"
                    Text="实际位置："
                    FontSize="13"
                    Foreground="#FF6B7280"
                    VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="0"
                    Grid.Column="1"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center">

                    <Run Text="{Binding Runtime.ActualPosition,
                                Mode=OneWay,
                                StringFormat={}{0:F3}}"/>

                    <Run Text=" "/>

                    <Run Text="{Binding Definition.Units.Position,
                                Mode=OneWay,
                                FallbackValue=mm}"/>

                        </TextBlock>

                        <!-- 实际速度 -->
                        <TextBlock Grid.Row="0"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Text="实际速度："
                    FontSize="13"
                    Foreground="#FF6B7280"
                    VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="0"
                    Grid.Column="3"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center">

                    <Run Text="{Binding Runtime.ActualVelocity,
                                Mode=OneWay,
                                StringFormat={}{0:F2}}"/>

                    <Run Text=" "/>

                    <Run Text="{Binding Definition.Units.Velocity,
                                Mode=OneWay,
                                FallbackValue=mm/s}"/>

                        </TextBlock>

                        <!-- 设定位置 -->
                        <TextBlock Grid.Row="1"
                    Grid.Column="0"
                    Text="设定位置："
                    FontSize="13"
                    Foreground="#FF6B7280"
                    VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                    Grid.Column="1"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center">

                    <Run Text="{Binding CommandParameters.TargetPosition,
                                Mode=OneWay,
                                StringFormat={}{0:F3}}"/>

                    <Run Text=" "/>

                    <Run Text="{Binding Definition.Units.Position,
                                Mode=OneWay,
                                FallbackValue=mm}"/>

                        </TextBlock>

                        <!-- 设定速度 -->
                        <TextBlock Grid.Row="1"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Text="设定速度："
                    FontSize="13"
                    Foreground="#FF6B7280"
                    VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1"
                    Grid.Column="3"
                    FontSize="13"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center">

                    <Run Text="{Binding CommandParameters.Velocity,
                                Mode=OneWay,
                                StringFormat={}{0:F2}}"/>

                    <Run Text=" "/>

                    <Run Text="{Binding Definition.Units.Velocity,
                                Mode=OneWay,
                                FallbackValue=mm/s}"/>

                        </TextBlock>

                    </Grid>

                    <!-- 第四行：简要轴状态 -->
                    <ContentControl
                Grid.Row="3"
                Content="{Binding}"
                ContentTemplate="{StaticResource AxisStatusSummaryTemplate}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"/>

                </Grid>

            </Border>

        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 14轴实时数据 -->
            <RowDefinition Height="68*"/>

            <!-- 当前轴调试 -->
            <RowDefinition Height="32*"/>
        </Grid.RowDefinitions>
        <!-- 14轴实时数据 -->
        <Grid Grid.Row="0"
            Margin="0,0,1,0">
            <Grid.ColumnDefinitions>
                <!-- 第一列：阻尼器上下料 -->
                <ColumnDefinition Width="1*"/>

                <!-- 第二列：料盘上下料、转台 -->
                <ColumnDefinition Width="1*"/>

                <!-- 第三列：同轴度调整、螺丝刀 -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 第一列：阻尼器上下料 -->
            <HeaderedContentControl Grid.Column="0"
                Header="阻尼器上下料"
                Style="{StaticResource TitledPanelStyle}"
                Margin="0,0,1,0">

                <!-- 5根轴 -->
                <ListBox ItemsSource="{Binding AxisStatus.DamperLoadingGroup.Axes}"
                    SelectedItem="{Binding SelectedDamperAxis, Mode=TwoWay}"
                    SelectionMode="Single"
                    ItemTemplate="{StaticResource AxisItemTemplate}"
                    Style="{StaticResource AxisListBoxStyle}">

                </ListBox>
            </HeaderedContentControl>

            <!-- 第二列 -->
            <Grid Grid.Column="1"
                Margin="0,0,1,0">

                <Grid.RowDefinitions>
                    <!-- 料盘上下料 -->
                    <RowDefinition Height="1*"/>

                    <!-- 转台 -->
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- 料盘上下料 -->
                <HeaderedContentControl Grid.Row="0"
                    Header="料盘上下料"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="0,0,0,1">

                    <ListBox ItemsSource="{Binding AxisStatus.TrayLoadingGroup.Axes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedTrayAxis, Mode=TwoWay}"
                        Style="{StaticResource AxisListBoxStyle}"
                        ItemTemplate="{StaticResource AxisItemTemplate}"/>
                </HeaderedContentControl>

                <!-- 转台及夹紧轴 -->
                <HeaderedContentControl Grid.Row="1"
                    Header="转台及夹紧"
                    Style="{StaticResource TitledPanelStyle}">

                    <ListBox ItemsSource="{Binding AxisStatus.TurntableGroup.Axes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedTurntableAxis, Mode=TwoWay}"
                        Style="{StaticResource AxisListBoxStyle}"
                        ItemTemplate="{StaticResource AxisItemTemplate}"/>
                </HeaderedContentControl>

            </Grid>

            <!-- 第三列 -->
            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <!-- 同轴度调整：3根轴 -->
                    <RowDefinition Height="3*"/>

                    <!-- 螺丝刀：2根轴 -->
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- 同轴度调整 -->
                <HeaderedContentControl Grid.Row="0"
                    Header="同轴度调整"
                    Style="{StaticResource TitledPanelStyle}"
                    Margin="0,0,0,2">

                    <ListBox ItemsSource="{Binding AxisStatus.AdjustmentGroup.Axes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedAdjustmentAxis, Mode=TwoWay}"
                        Style="{StaticResource AxisListBoxStyle}"
                        ItemTemplate="{StaticResource AxisItemTemplate}"/>
                </HeaderedContentControl>

                <!-- 螺丝刀轴 -->
                <HeaderedContentControl Grid.Row="1"
                    Header="螺丝刀轴"
                    Style="{StaticResource TitledPanelStyle}">

                    <ListBox ItemsSource="{Binding AxisStatus.ScrewdriverGroup.Axes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedScrewdriverAxis, Mode=TwoWay}"
                        Style="{StaticResource AxisListBoxStyle}"
                        ItemTemplate="{StaticResource AxisItemTemplate}"/>
                </HeaderedContentControl>

            </Grid>
        </Grid>

        <!-- 单轴调试 -->
        <Grid Grid.Row="1"
            Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <!-- 详细状态 -->
                <ColumnDefinition Width="2*"/>

                <!-- 调试操作 -->
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <!-- 选中轴的详细信息 -->
            <HeaderedContentControl Grid.Column="0"
                Header="{Binding SelectedAxisDetailHeader}"
                Style="{StaticResource TitledPanelStyle}"
                Margin="0,0,1,0">

                <Grid Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="0.9*"/>
                        <RowDefinition Height="1.1*"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：实际数据 -->
                    <UniformGrid Grid.Row="0"
                        Rows="1"
                        Columns="3">

                        <!-- 实际位置 -->
                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="实际位置："
                                    Foreground="#FF6B7280"/>
                                <Run Text="{Binding SelectedAxis.Runtime.ActualPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:F3}}"
                                    FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=mm}"/>
                            </TextBlock>
                        </Border>

                        <!-- 实际速度 -->
                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="实际速度："
                                    Foreground="#FF6B7280"/>
                                <Run Text="{Binding SelectedAxis.Runtime.ActualVelocity,
                                    Mode=OneWay,
                                    StringFormat={}{0:F2}}"
                                    FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedAxis.Definition.Units.Velocity,
                                    Mode=OneWay,
                                    FallbackValue=mm/s}"/>
                            </TextBlock>
                        </Border>

                        <!-- 实际转矩 -->
                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="实际转矩："
                                    Foreground="#FF6B7280"/>
                                <Run Text="{Binding SelectedAxis.Runtime.ActualTorque,
                                    Mode=OneWay,
                                    StringFormat={}{0:F1}}"
                                    FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedAxis.Definition.Units.Torque,
                                    Mode=OneWay,
                                    FallbackValue=N·m}"/>
                            </TextBlock>
                        </Border>
                    </UniformGrid>

                    <!-- 第二行：设定数据 -->
                    <UniformGrid Grid.Row="1"
                        Rows="1"
                        Columns="3">
                        <!-- 设定位置 -->
                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="设定位置："
                                    Foreground="#FF6B7280"/>
                                <Run Text="{Binding SelectedAxis.CommandParameters.TargetPosition,
                                    Mode=OneWay,
                                    StringFormat={}{0:F2}}"
                                    FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedAxis.Definition.Units.Position,
                                    Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <!-- 设定速度 -->
                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="设定速度："
                                    Foreground="#FF6B7280"/>
                                <Run Text="{Binding SelectedAxis.CommandParameters.Velocity,
                                    Mode=OneWay,
                                    StringFormat={}{0:F2}}"
                                    FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedAxis.Definition.Units.Velocity,
                                    Mode=OneWay,
                                    FallbackValue=mm/s}"/>
                            </TextBlock>
                        </Border>
                        <!-- 设定转矩 -->
                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="设定转矩："
                                    Foreground="#FF6B7280"/>
                                <Run Text="{Binding SelectedAxis.CommandParameters.Torque,
                                    Mode=OneWay,
                                    StringFormat={}{0:F2},
                                    FallbackValue=--}"
                                    FontWeight="SemiBold"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedAxis.Definition.Units.Torque,
                                    Mode=OneWay,
                                    FallbackValue=N·m}"/>
                            </TextBlock>
                        </Border>
                    </UniformGrid>

                    <!-- 第三行：运动偏差 -->
                    <UniformGrid Grid.Row="2"
                        Rows="1"
                        Columns="3">

                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="剩余距离："
                                    Foreground="#FF6B7280"/>
                                <!-- 预留项：当前阶段不新增 C# 属性或绑定。 -->
                                <Run Text="--"
                                    FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>

                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="跟随误差："
                                    Foreground="#FF6B7280"/>
                                <!-- 预留项：当前阶段不新增 C# 属性或绑定。 -->
                                <Run Text="--"
                                    FontWeight="SemiBold"
                                    Foreground="#FFF59E0B"/>
                            </TextBlock>
                        </Border>

                        <Border Style="{StaticResource AxisDetailCellStyle}">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="运动状态："
                                    Foreground="#FF6B7280"/>
                                <Run Text="{Binding SelectedAxis.MotionStatusText,
                                    Mode=OneWay,
                                    FallbackValue=--}"
                                    FontWeight="SemiBold"
                                    Foreground="#FF2563EB"/>
                            </TextBlock>
                        </Border>
                    </UniformGrid>

                    <!--
                    第四行：轴状态。
                    -->
                    <ContentControl
                        Grid.Row="3"
                        Margin="3"
                        Content="{Binding SelectedAxis}"
                        ContentTemplate="{StaticResource AxisStatusDetailTemplate}"/>
                    <!-- 第五行：故障信息 -->
                    <Border Grid.Row="4"
                        Style="{StaticResource AxisDetailCellStyle}"
                        Margin="3">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                Text="故障代码："
                                Foreground="#FF6B7280"
                                VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                FontWeight="SemiBold"
                                Foreground="#FFDC2626"
                                VerticalAlignment="Center">
                                <Run Text="0x"/>
                                <Run Text="{Binding SelectedAxis.Runtime.ErrorCode,
                                Mode=OneWay,
                                StringFormat={}{0:X8},
                                FallbackValue=--------}"/>
                            </TextBlock>

                            <TextBlock Grid.Column="2"
                                Text="故障信息："
                                Foreground="#FF6B7280"
                                VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3"
                                Text="--"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </HeaderedContentControl>
            <!-- 选中轴的调试操作 -->
            <HeaderedContentControl Grid.Column="1"
                Header="{Binding SelectedAxisDebugHeader}"
                Style="{StaticResource TitledPanelStyle}"
                Margin="1,0,0,0">
                <Grid Margin="6">
                    <!--
                    当前调试轴横向划分为三个区域：
                    运动模式 : 参数设置 : 基础操作 = 4 : 2 : 4。
                    -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧40%：运动模式选择。 -->
                    <Border Grid.Column="0"
                        Style="{StaticResource CurrentDebugSectionBorderStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- 下拉框 -->
                                <RowDefinition Height="Auto"/>

                                <!-- 剩余提示区域 -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                                                <!--
                            不再显示“运动模式”标题，
                            下拉框直接放置在第一列左上角。
                            -->
                            <ComboBox x:Name="MotionModeComboBox"
                                    Grid.Row="0"
                                    Width="120"
                                    Height="44"
                                    Padding="10,4"
                                    SelectedIndex="0"
                                    FontSize="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center">

                                <ComboBoxItem Content="绝对运动"
                                    HorizontalContentAlignment="Center"/>

                                <ComboBoxItem Content="相对运动"
                                    HorizontalContentAlignment="Center"/>

                                <ComboBoxItem Content="点动运动"
                                    HorizontalContentAlignment="Center"/>

                            </ComboBox>

                            <!--
                            绝对运动界面：选择下拉框第1项时显示。
                            第一行输入目标位置，第二行放置绝对运动按钮。
                            -->
                            <Grid x:Name="AbsoluteMotionPanel"
                                    Grid.Row="1"
                                    Margin="0,16,0,0">

                                <!-- 根据下拉框选择结果控制显示 -->
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <!-- SelectedIndex=0 对应“绝对运动” -->
                                            <DataTrigger Binding="{Binding SelectedIndex,
                                                ElementName=MotionModeComboBox}"
                                                Value="0">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.RowDefinitions>
                                    <!-- 第一行：目标位置输入框 -->
                                    <RowDefinition Height="*"/>

                                    <!-- 两行之间的间距 -->
                                    <RowDefinition Height="16"/>

                                    <!-- 第二行：输入范围 -->
                                    <RowDefinition Height="Auto"/>

                                    <!-- 两行之间的间距 -->
                                    <RowDefinition Height="16"/>
                                    
                                    <!-- 第三行：绝对运动按钮 -->
                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>

                                <!--
                                第一行划分为三列：
                                目标位置说明 : 输入框 : 单位 = 2 : 5 : 1。
                                -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 第一列：参数名称 -->
                                    <TextBlock Grid.Column="0"
                                        Text="目标位置："
                                        FontSize="16"
                                        Foreground="#FF374151"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>

                                    <!-- 第二列：目标位置输入框 -->
                                    <TextBox x:Name="AbsolutePositionTextBox"
                                        Grid.Column="1"
                                        Height="30"
                                        Margin="8,0"
                                        Padding="10,4"
                                        Text="{Binding DebugInput.TargetPosition,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=LostFocus}"
                                        FontSize="16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"/>

                                    <!-- 第三列：位置单位 -->
                                    <TextBlock Grid.Column="2"
                                        Text="{Binding SelectedAxis.Definition.Units.Position,
                                        Mode=OneWay,
                                        FallbackValue=mm}"
                                        FontSize="16"
                                        Foreground="#FF374151"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"/>

                                </Grid>

                                <!-- 第二行：目标位置输入范围 -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <!-- 与目标位置输入行保持相同比例 -->
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 提示文字与输入框左侧对齐 -->
                                    <TextBlock Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="8,0,0,0"
                                        FontSize="13"
                                        Foreground="#FF6B7280"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">

                                        <Run Text="输入范围："/>
                                        <Run Text="-100.00 ～ 500.00"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding SelectedAxis.Definition.Units.Position,
                                            Mode=OneWay,
                                            FallbackValue=mm}"/>
                                    </TextBlock>
                                </Grid>

                                <!-- 绝对运动按钮 -->
                                <Button x:Name="AbsoluteMoveButton"
                                    Grid.Row="4"
                                    Width="120"
                                    Height="44"
                                    Content="绝对运动"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Background="#FF2563EB"
                                    BorderBrush="#FF1D4ED8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Grid>

                            <!--
                            相对运动界面：选择下拉框第2项时显示。
                            结构与绝对运动界面保持一致。
                            -->
                            <Grid x:Name="RelativeMotionPanel"
                                    Grid.Row="1"
                                    Margin="0,16,0,0">

                                <!-- SelectedIndex=1时显示相对运动界面 -->
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex,
                                                ElementName=MotionModeComboBox}"
                                                Value="1">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.RowDefinitions>
                                    <!-- 第一行：相对距离输入框 -->
                                    <RowDefinition Height="*"/>

                                    <!-- 间距 -->
                                    <RowDefinition Height="16"/>

                                    <!-- 第二行：输入范围提示 -->
                                    <RowDefinition Height="Auto"/>

                                    <!-- 间距 -->
                                    <RowDefinition Height="16"/>

                                    <!-- 第三行：相对运动按钮 -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 第一行：参数名称、输入框、单位 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 第一列：参数名称 -->
                                    <TextBlock Grid.Column="0"
                                        Text="相对距离："
                                        FontSize="16"
                                        Foreground="#FF374151"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>

                                    <!-- 第二列：相对距离输入框 -->
                                    <TextBox x:Name="RelativeDistanceTextBox"
                                        Grid.Column="1"
                                        Height="30"
                                        Margin="8,0"
                                        Padding="10,4"
                                        Text="{Binding DebugInput.RelativeDistance,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus}"
                                        FontSize="16"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        ToolTip="请输入相对运动距离"/>

                                    <!-- 第三列：距离单位 -->
                                    <TextBlock Grid.Column="2"
                                        Text="{Binding SelectedAxis.Definition.Units.Position,
                                        Mode=OneWay,
                                        FallbackValue=mm}"
                                        FontSize="16"
                                        Foreground="#FF374151"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 第二行：相对距离输入范围 -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="8,0,0,0"
                                        FontSize="13"
                                        Foreground="#FF6B7280"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">

                                        <Run Text="输入范围："/>
                                        <Run Text="0.00 ～ 500.00"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding SelectedAxis.Definition.Units.Position,
                                            Mode=OneWay,
                                            FallbackValue=mm}"/>
                                    </TextBlock>
                                </Grid>

                                <!-- 第三行：两个相对运动方向按钮 -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <!-- 第一个方向按钮 -->
                                        <ColumnDefinition Width="*"/>

                                        <!-- 按钮间距 -->
                                        <ColumnDefinition Width="16"/>

                                        <!-- 第二个方向按钮 -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--
                                    按钮文字随SelectedAxis变化。
                                    CommandParameter传递实际坐标方向。
                                    -->
                                    <Button Grid.Column="0"
                                        Width="120"
                                        Content="{Binding SelectedAxis.Definition.PositiveDirectionText,
                                            FallbackValue=左移}"
                                        Command="{Binding RelativeMoveCommand}"
                                        CommandParameter="{StaticResource PositiveDirectionFactor}"
                                        Style="{StaticResource NormalButtonStyle}"
                                        Background="#FF2563EB"
                                        BorderBrush="#FF1D4ED8"/>

                                    <Button Grid.Column="2"
                                        Width="120"
                                        Content="{Binding SelectedAxis.Definition.NegativeDirectionText,
                                            FallbackValue=右移}"
                                        Command="{Binding RelativeMoveCommand}"
                                        CommandParameter="{StaticResource NegativeDirectionFactor}"
                                        Style="{StaticResource NormalButtonStyle}"
                                        Background="#FF4B5563"
                                        BorderBrush="#FF374151"/>
                                </Grid>

                            </Grid>

                            <!--
                            点动界面：选择下拉框第3项时显示。
                            两个按钮复用相对运动的方向文字。
                            -->
                            <Grid x:Name="JogMotionPanel"
                                Grid.Row="1"
                                Margin="0,16,0,0">

                                <!-- SelectedIndex=2时显示点动界面 -->
                                <Grid.Style>
                                    <Style TargetType="{x:Type Grid}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex,
                                                ElementName=MotionModeComboBox}"
                                                Value="2">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!-- 两个点动按钮横向排列 -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!--
                                第一个方向：
                                前移、左移、上移或顺时针。
                                -->
                                <Button x:Name="JogDirection1Button"
                                    Grid.Column="0"
                                    Height="44"
                                    Width="120"
                                    Content="{Binding SelectedAxis.Definition.PositiveDirectionText,
                                        FallbackValue=正向点动}"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Background="#FF2563EB"
                                    BorderBrush="#FF1D4ED8"
                                    VerticalAlignment="Center"
                                    ToolTip="按住开始点动，松开停止"/>

                                <!--
                                第二个方向：
                                后移、右移、下移或逆时针。
                                -->
                                <Button x:Name="JogDirection2Button"
                                    Grid.Column="2"
                                    Height="44"
                                    Width="120"
                                    Content="{Binding SelectedAxis.Definition.NegativeDirectionText,
                                        FallbackValue=负向点动}"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Background="#FF4B5563"
                                    BorderBrush="#FF374151"
                                    VerticalAlignment="Center"
                                    ToolTip="按住开始点动，松开停止"/>

                            </Grid>
                        </Grid>
                    </Border>
                    <!-- 右侧20%：四个基础操作按钮，自上而下排列。 -->
                    <Border Grid.Column="1"
                        Style="{StaticResource CurrentDebugSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 轴使能保持为状态按钮，当前不绑定实际使能命令。 -->
                            <ToggleButton Grid.Row="0"
                                          IsChecked="{Binding SelectedAxis.Runtime.IsEnabled,
                                          Mode=OneWay}"
                                          Width="120">
                                <ToggleButton.Style>
                                    <Style TargetType="{x:Type ToggleButton}"
                                        BasedOn="{StaticResource ToggleStateButtonStyle}">
                                        <Setter Property="Content" Value="轴使能"/>
                                        <Setter Property="Background" Value="#FF16A34A"/>
                                        <Setter Property="BorderBrush" Value="#FF15803D"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="掉使能"/>
                                                <Setter Property="Background" Value="#FFDC2626"/>
                                                <Setter Property="BorderBrush" Value="#FFB91C1C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <Button Grid.Row="2"
                                Width="120"
                                Content="回零"
                                Style="{StaticResource NormalButtonStyle}"
                                Background="#FF2563EB"
                                BorderBrush="#FF1D4ED8"/>

                            <Button Grid.Row="4"
                                Width="120"
                                Content="故障复位"
                                Style="{StaticResource NormalButtonStyle}"
                                Background="#FFF59E0B"
                                BorderBrush="#FFD97706"/>

                            <Button Grid.Row="6"
                                Width="120"
                                Content="停止"
                                Style="{StaticResource NormalButtonStyle}"
                                Background="#FFDC2626"
                                BorderBrush="#FFB91C1C"/>
                        </Grid>
                    </Border>
                    <!-- 中间40%：速度、力矩和零位位置设置。 -->
                    <Border Grid.Column="2"
                        Style="{StaticResource CurrentDebugSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- 标题 -->
                                <RowDefinition Height="Auto"/>

                                <!-- 标题与参数之间的间距 -->
                                <RowDefinition Height="12"/>

                                <!-- 速度 -->
                                <RowDefinition Height="*"/>

                                <!-- 力矩 -->
                                <RowDefinition Height="*"/>

                                <!-- 零位 -->
                                <RowDefinition Height="*"/>

                                <!-- 设置参数按钮 -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0"
                                Text="参数设置"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#FF1F2937"/>

                            <!-- 速度设置 -->
                            <Grid Grid.Row="2"
                                Margin="0,4">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>

                                <!-- 第一列：参数名称 -->
                                <TextBlock Grid.Column="0"
                                    Text="速度"
                                    Style="{StaticResource CurrentDebugParameterLabelStyle}"/>

                                <!-- 第二列：输入范围 -->
                                <TextBlock Grid.Column="1"
                                    Text="(0 ～ 100):"
                                    Margin="4,0,8,0"
                                    FontSize="13"
                                    Foreground="#FF6B7280"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <!-- 第三列：输入框 -->
                                <TextBox x:Name="VelocityTextBox"
                                    Height="30"
                                    Grid.Column="2"
                                    Text="{Binding DebugInput.Velocity,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=LostFocus}"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource CurrentDebugParameterTextBoxStyle}"/>

                                <!-- 第四列：单位 -->
                                <TextBlock Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Text="{Binding SelectedAxis.Definition.Units.Velocity,
                                    Mode=OneWay,
                                    FallbackValue=mm/s}"
                                    VerticalAlignment="Center"/>
                            </Grid>
                            <!-- 力矩设置 -->
                            <Grid Grid.Row="3"
                                Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                    Text="力矩："
                                    Style="{StaticResource CurrentDebugParameterLabelStyle}"/>
                                <TextBlock Grid.Column="1"
                                    Text="(0 ～ 100):"
                                    Margin="4,0,8,0"
                                    FontSize="13"
                                    Foreground="#FF6B7280"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                <TextBox x:Name="TorqueTextBox"
                                    Height="30"
                                    Grid.Column="2"
                                    Text="{Binding DebugInput.Torque,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=LostFocus}"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource CurrentDebugParameterTextBoxStyle}"/>
                                <TextBlock Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Text="{Binding SelectedAxis.Definition.Units.Torque,
                                    Mode=OneWay,
                                    FallbackValue=N·m}"
                                    VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 零位位置设置 -->
                            <Grid Grid.Row="4"
                                Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                    Text="零位："
                                    Style="{StaticResource CurrentDebugParameterLabelStyle}"/>
                                <TextBlock Grid.Column="1"
                                    Text="(-100 ～ 500):"
                                    Margin="4,0,8,0"
                                    FontSize="13"
                                    Foreground="#FF6B7280"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                <TextBox x:Name="ZeroPositionTextBox"
                                    Height="30"
                                    Grid.Column="2"
                                    Text="{Binding DebugInput.ZeroPosition,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=LostFocus}"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource CurrentDebugParameterTextBoxStyle}"/>
                                <TextBlock Grid.Column="3"
                                    Margin="8,0,0,0"
                                    Text="{Binding SelectedAxis.Definition.Units.Position,
                                    Mode=OneWay,
                                    FallbackValue=mm}"
                                    VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 设置速度、力矩和零位位置 -->
                            <Button x:Name="SetParametersButton"
                                Grid.Row="5"
                                Height="44"
                                Width="120"
                                Margin="90,8,65,0"
                                Content="写入参数"
                                Style="{StaticResource NormalButtonStyle}"
                                Background="#FF2563EB"
                                BorderBrush="#FF1D4ED8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </HeaderedContentControl>
        </Grid>
    </Grid>
</UserControl>
