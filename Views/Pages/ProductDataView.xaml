<UserControl x:Class="ZNQInterface.Views.Pages.ProductDataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZNQInterface.Views.Pages"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <!-- 左侧：筛选及统计区域 -->
            <ColumnDefinition Width="3*"/>

            <!-- 左右区域间距 -->
            <ColumnDefinition Width="5"/>

            <!-- 右侧：产品数据区域 -->
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <!-- 数据筛选及统计 -->
        <HeaderedContentControl Grid.Column="0"
            Header="数据筛选与统计"
            Style="{StaticResource TitledPanelStyle}">
            <!-- 数据筛选区域 -->
            <Grid Grid.Row="1"
                Margin="12">

                <Grid.RowDefinitions>
                    <!-- 产品编号搜索 -->
                    <RowDefinition Height="Auto"/>

                    <!-- 日期范围 -->
                    <RowDefinition Height="Auto"/>

                    <!-- 同轴度范围 -->
                    <RowDefinition Height="Auto"/>

                    <!-- 合格状态 -->
                    <RowDefinition Height="Auto"/>

                    <!-- 剩余空间 -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 第一行：产品编号搜索 -->
                <Border Grid.Row="0"
                    Margin="0,0,0,55"
                    Padding="10"
                    Background="#FFF9FAFB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">

                            <!-- 产品编号输入框 -->
                            <TextBox x:Name="ProductSearchTextBox"
                                Width="250"
                                Height="36"
                                Padding="8,3"
                                Text="{Binding ProductSearchText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"/>

                            <!-- 灰色占位提示 -->
                            <TextBlock Margin="10,0,0,0"
                                Text="请输入产品编号"
                                FontSize="14"
                                Foreground="#FF9CA3AF"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">

                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">

                                        <!-- 默认隐藏 -->
                                        <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                        <Style.Triggers>

                                            <!-- 输入框为空时显示 -->
                                            <DataTrigger Binding="{Binding Text,
                                                ElementName=ProductSearchTextBox}"
                                                Value="">

                                                <Setter Property="Visibility"
                                                    Value="Visible"/>
                                            </DataTrigger>

                                            <!-- 输入框获得焦点时隐藏 -->
                                            <DataTrigger Binding="{Binding IsKeyboardFocused,
                                                ElementName=ProductSearchTextBox}"
                                                Value="True">

                                                <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2"
                            Height="36"
                            Content="搜索"
                            Command="{Binding SearchProductCommand}"
                            Style="{StaticResource NormalButtonStyle}"
                            Background="#FF2563EB"
                            BorderBrush="#FF1D4ED8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 第二行：日期范围 -->
                <Border Grid.Row="1"
                    Margin="0,55,0,55"
                    Padding="10"
                    Background="#FFF9FAFB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                            Margin="0,0,0,7"
                            Text="检测日期范围"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FF374151"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 开始日期 -->
                            <DatePicker Grid.Column="0"
                                Height="36"
                                SelectedDate="{Binding DateFilter.StartDate,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"
                                FontSize="14"
                                VerticalContentAlignment="Center"
                                ToolTip="选择开始日期"/>

                            <TextBlock Grid.Column="1"
                                Text="至"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#FF6B7280"/>

                            <!-- 结束日期 -->
                            <DatePicker Grid.Column="2"
                                Height="36"
                                SelectedDate="{Binding DateFilter.EndDate,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"
                                FontSize="14"
                                VerticalContentAlignment="Center"
                                ToolTip="选择结束日期"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 第三行：同轴度范围 -->
                <Border Grid.Row="2"
                    Margin="0,55,0,55"
                    Padding="10"
                    Background="#FFF9FAFB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                            Margin="0,0,0,7"
                            Text="同轴度范围"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FF374151"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>

                            <!-- 同轴度下限 -->
                            <TextBox Grid.Column="0"
                                Height="36"
                                Padding="8,3"
                                Text="{Binding MinimumCoaxialityText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip="请输入同轴度下限"/>

                            <TextBlock Grid.Column="1"
                                Text="至"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#FF6B7280"/>

                            <!-- 同轴度上限 -->
                            <TextBox Grid.Column="2"
                                Height="36"
                                Padding="8,3"
                                Text="{Binding MaximumCoaxialityText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip="请输入同轴度上限"/>

                            <TextBlock Grid.Column="3"
                                Text="mm"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#FF374151"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 第四行：合格状态 -->
                <Border Grid.Row="3"
                    Margin="0,55,0,0"
                    Padding="10"
                    Background="#FFF9FAFB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            Text="检测结果："
                            FontSize="14"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Foreground="#FF374151"/>

                        <ComboBox Grid.Column="2"
                            Height="36"
                            Width="120"
                            SelectedValue="{Binding SelectedQualificationStatus,
                            Mode=TwoWay}"
                            SelectedValuePath="Tag"
                            FontSize="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">

                            <ComboBoxItem Content="全部产品"
                                Tag="All"
                                IsSelected="True"/>

                            <ComboBoxItem Content="合格产品"
                                Tag="Qualified"/>

                            <ComboBoxItem Content="不合格产品"
                                Tag="Unqualified"/>
                        </ComboBox>
                    </Grid>
                </Border>
            </Grid>
        </HeaderedContentControl>

        <!-- 产品检测数据 -->
        <HeaderedContentControl Grid.Column="2"
            Style="{StaticResource TitledPanelStyle}">

            <!-- 标题栏 -->
            <HeaderedContentControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧标题 -->
                    <TextBlock Grid.Column="0"
                        Text="产品检测数据"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#FF111827"
                        VerticalAlignment="Center"/>

                    <!-- 右侧产品数量 -->
                    <TextBlock Grid.Column="1"
                        FontSize="13"
                        FontWeight="Normal"
                        Foreground="#FF6B7280"
                        VerticalAlignment="Center">

                        <Run Text="当前共 "/>

                        <Run Text="{Binding Pagination.TotalItemCount,
                            Mode=OneWay}"
                            FontWeight="SemiBold"
                            Foreground="#FF111827"/>

                        <Run Text=" 项"/>
                    </TextBlock>
                </Grid>
            </HeaderedContentControl.Header>

            <!-- 表格及分页栏 -->
            <Grid>
                <Grid.RowDefinitions>

                    <!-- 表格区域 -->
                    <RowDefinition Height="*"/>

                    <!-- 表格与分页栏间距 -->
                    <RowDefinition Height="8"/>

                    <!-- 底部分页栏 -->
                    <RowDefinition Height="44"/>

                </Grid.RowDefinitions>

                <!-- 产品数据表格 -->
                <DataGrid Grid.Row="0"
                    ItemsSource="{Binding Pagination.PagedProducts}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="True"
                    HeadersVisibility="Column"
                    ColumnHeaderStyle="{StaticResource CommonDataGridHeaderStyle}"
                    RowHeaderWidth="0"
                    RowHeight="42"
                    Background="White"
                    AlternatingRowBackground="#FFF9FAFB"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#FFE5E7EB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="日期时间"
                            Width="3*"
                            CanUserSort="True"
                            SortMemberPath="DetectionTime"
                            ElementStyle="{StaticResource CommonDataGridCenterTextStyle}"
                            Binding="{Binding DetectionTime,
                            Mode=OneWay,
                            StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>

                            <DataGridTextColumn Header="产品编号"
                            Width="3*"
                            CanUserSort="True"
                            SortMemberPath="ProductNumber"
                            ElementStyle="{StaticResource CommonDataGridCenterTextStyle}"
                            Binding="{Binding ProductNumber,
                            Mode=OneWay}"/>

                            <DataGridTextColumn Header="同轴度数据（mm）"
                            Width="2*"
                            CanUserSort="True"
                            SortMemberPath="Coaxiality"
                            ElementStyle="{StaticResource CommonDataGridCenterTextStyle}"
                            Binding="{Binding Coaxiality,
                            Mode=OneWay,
                            StringFormat={}{0:F3}}"/>

                            <DataGridTextColumn Header="是否合格"
                            Width="2*"
                            CanUserSort="True"
                            SortMemberPath="IsQualified"
                            ElementStyle="{StaticResource CommonDataGridCenterTextStyle}"
                            Binding="{Binding QualificationText,
                            Mode=OneWay}"/>

                    </DataGrid.Columns>
                        </DataGrid>

                        <!-- 底部分页栏 -->
                        <Border Grid.Row="2"
                            Padding="6,4"
                            Background="#FFF9FAFB"
                            BorderBrush="#FFE5E7EB"
                            BorderThickness="1"
                            CornerRadius="4">

                            <Grid>
                                <Grid.ColumnDefinitions>

                                    <!-- 左侧分页按钮 -->
                                    <ColumnDefinition Width="2*"/>

                                    <!-- 右侧页码信息 -->
                                    <ColumnDefinition Width="1*"/>

                                </Grid.ColumnDefinitions>

                                <!-- 左侧：首页、上一页、页码、下一页、尾页 -->
                                <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                                    <Button Content="首页"
                                        MinWidth="60"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding Pagination.FirstPageCommand}"/>

                                    <Button Content="上一页"
                                        MinWidth="70"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding Pagination.PreviousPageCommand}"/>

                                    <!-- 动态页码按钮 -->
                                    <ItemsControl ItemsSource="{Binding Pagination.PageNumbers}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Button Content="{Binding PageNumber}"
                                                    Command="{Binding DataContext.Pagination.GoToPageCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding PageNumber}">

                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}"
                                                            BasedOn="{StaticResource PaginationButtonStyle}">

                                                            <Style.Triggers>
                                                                <!-- 当前页突出显示 -->
                                                                <DataTrigger Binding="{Binding IsCurrent}"
                                                                    Value="True">

                                                                    <Setter Property="Background"
                                                                        Value="#FF2563EB"/>

                                                                    <Setter Property="Foreground"
                                                                        Value="White"/>

                                                                    <Setter Property="BorderBrush"
                                                                        Value="#FF1D4ED8"/>

                                                                    <Setter Property="FontWeight"
                                                                        Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>

                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="下一页"
                                        MinWidth="70"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding Pagination.NextPageCommand}"/>

                                    <Button Content="尾页"
                                        MinWidth="60"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding Pagination.LastPageCommand}"/>
                                </StackPanel>

                                <!-- 右侧：第几页/共几页 -->
                                <TextBlock Grid.Column="1"
                                    Margin="16,0,8,0"
                                    FontSize="13"
                                    Foreground="#FF6B7280"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">

                                    <Run Text="第 "/>

                                    <Run Text="{Binding Pagination.CurrentPage,
                                        Mode=OneWay}"
                                        FontWeight="SemiBold"
                                        Foreground="#FF2563EB"/>

                                    <Run Text=" 页 / 共 "/>

                                    <Run Text="{Binding Pagination.TotalPages,
                                        Mode=OneWay}"
                                        FontWeight="SemiBold"
                                        Foreground="#FF111827"/>

                                    <Run Text=" 页"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </HeaderedContentControl>
            </Grid>
        </UserControl>
