<UserControl x:Class="ZNQInterface.Views.Pages.OperationLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZNQInterface.Views.Pages"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>

            <!-- 左侧筛选区域 -->
            <ColumnDefinition Width="3*"/>

            <!-- 间距 -->
            <ColumnDefinition Width="5"/>

            <!-- 右侧日志区域 -->
            <ColumnDefinition Width="7*"/>

        </Grid.ColumnDefinitions>

        <!-- 左侧：日志筛选 -->
        <HeaderedContentControl Grid.Column="0"
            Header="日志筛选"
            Style="{StaticResource TitledPanelStyle}">

            <Grid Margin="12">
                <Grid.RowDefinitions>

                    <!-- 日志内容搜索 -->
                    <RowDefinition Height="Auto"/>

                    <!-- 日期范围 -->
                    <RowDefinition Height="Auto"/>

                    <!-- 日志类型 -->
                    <RowDefinition Height="Auto"/>

                    <!-- 剩余空间 -->
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- 第一行：日志内容搜索 -->
                <Border Grid.Row="0"
                    Margin="0,0,0,55"
                    Padding="10"
                    Background="#FFF9FAFB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 输入框和占位提示 -->
                        <Grid Grid.Column="0">

                            <TextBox x:Name="LogSearchTextBox"
                                Width="250"
                                Height="36"
                                Padding="8,3"
                                Text="{Binding LogSearchText,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"/>

                            <TextBlock Margin="10,0,0,0"
                                Text="请输入日志信息"
                                FontSize="14"
                                Foreground="#FF9CA3AF"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">

                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Text,
                                                ElementName=LogSearchTextBox}"
                                                Value="">
                                                <Setter Property="Visibility"
                                                    Value="Visible"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding IsKeyboardFocused,
                                                ElementName=LogSearchTextBox}"
                                                Value="True">
                                                <Setter Property="Visibility"
                                                    Value="Collapsed"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2"
                            Height="36"
                            Content="搜索"
                            Command="{Binding SearchLogCommand}"
                            Style="{StaticResource NormalButtonStyle}"
                            Background="#FF2563EB"
                            BorderBrush="#FF1D4ED8"
                            HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <!-- 第二行：日期范围 -->
                <Border Grid.Row="1"
                    Margin="0,55,0,55"
                    Padding="10"
                    Background="#FFF9FAFB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                            Margin="0,0,0,7"
                            Text="日志日期范围"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FF374151"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker Grid.Column="0"
                                Height="36"
                                SelectedDate="{Binding DateFilter.StartDate,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"
                                FontSize="14"
                                VerticalContentAlignment="Center"
                                ToolTip="选择开始日期"/>

                            <TextBlock Grid.Column="1"
                                Text="至"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#FF6B7280"/>

                            <DatePicker Grid.Column="2"
                                Height="36"
                                SelectedDate="{Binding DateFilter.EndDate,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"
                                FontSize="14"
                                VerticalContentAlignment="Center"
                                ToolTip="选择结束日期"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 第三行：日志类型 -->
                <Border Grid.Row="2"
                    Margin="0,55,0,0"
                    Padding="10"
                    Background="#FFF9FAFB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    CornerRadius="4">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            Text="日志类型："
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FF374151"
                            VerticalAlignment="Center"/>

                        <ComboBox Grid.Column="2"
                            Height="36"
                            SelectedValue="{Binding SelectedLogType,
                            Mode=TwoWay}"
                            SelectedValuePath="Tag"
                            FontSize="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">

                            <ComboBoxItem Content="全部类型"
                                Tag="All"
                                IsSelected="True"/>

                            <ComboBoxItem Content="正常"
                                Tag="Normal"/>

                            <ComboBoxItem Content="报警"
                                Tag="Alarm"/>

                            <ComboBoxItem Content="故障"
                                Tag="Fault"/>
                        </ComboBox>
                    </Grid>
                </Border>
            </Grid>
        </HeaderedContentControl>

        <!-- 右侧：日志信息 -->
        <HeaderedContentControl Grid.Column="2"
            Style="{StaticResource TitledPanelStyle}">

            <HeaderedContentControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                        Text="操作日志"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#FF111827"
                        VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                        FontSize="13"
                        FontWeight="Normal"
                        Foreground="#FF6B7280"
                        VerticalAlignment="Center">

                        <Run Text="当前共 "/>

                        <Run Text="{Binding Pagination.TotalItemCount}"
                            FontWeight="SemiBold"
                            Foreground="#FF111827"/>

                        <Run Text=" 项"/>
                    </TextBlock>
                </Grid>
            </HeaderedContentControl.Header>

            <Grid>
                <Grid.RowDefinitions>

                    <!-- 表头和日志数据 -->
                    <RowDefinition Height="*"/>

                    <!-- 间距 -->
                    <RowDefinition Height="8"/>

                    <!-- 分页栏 -->
                    <RowDefinition Height="44"/>

                </Grid.RowDefinitions>

                <!-- 第一、二行：表头及日志数据 -->
                <DataGrid Grid.Row="0"
                    ItemsSource="{Binding Pagination.PagedLogs}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="True"
                    HeadersVisibility="Column"
                    ColumnHeaderStyle="{StaticResource CommonDataGridHeaderStyle}"
                    RowHeaderWidth="0"
                    RowHeight="42"
                    Background="White"
                    AlternatingRowBackground="#FFF9FAFB"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#FFE5E7EB"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="1"
                    EnableRowVirtualization="True"
                    EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>

                        <!-- 日期时间 -->
                        <DataGridTextColumn Header="日期时间"
                            Width="3*"
                            CanUserSort="True"
                            SortMemberPath="LogTime"
                            ElementStyle="{StaticResource CommonDataGridCenterTextStyle}"
                            Binding="{Binding LogTime,
                            Mode=OneWay,
                            StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>

                        <!-- 日志类型 -->
                            <DataGridTextColumn Header="日志类型"
                            Width="2*"
                            CanUserSort="True"
                            SortMemberPath="LogType"
                            ElementStyle="{StaticResource CommonDataGridCenterTextStyle}"
                            Binding="{Binding LogTypeText,
                            Mode=OneWay}"/>

                        <!-- 日志信息 -->
                            <DataGridTextColumn Header="日志信息"
                            Width="5*"
                            CanUserSort="True"
                            SortMemberPath="LogMessage"
                            ElementStyle="{StaticResource CommonDataGridMessageTextStyle}"
                            Binding="{Binding LogMessage,
                            Mode=OneWay}"/>

                    </DataGrid.Columns>
                        </DataGrid>

                        <!-- 第三行：分页按钮和页码 -->
                        <Border Grid.Row="2"
                            Padding="6,4"
                            Background="#FFF9FAFB"
                            BorderBrush="#FFE5E7EB"
                            BorderThickness="1"
                            CornerRadius="4">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧分页操作 -->
                                <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                                    <Button Content="首页"
                                        MinWidth="60"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding Pagination.FirstPageCommand}"/>

                                    <Button Content="上一页"
                                        MinWidth="70"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding Pagination.PreviousPageCommand}"/>

                                    <!-- 动态页码 -->
                                    <ItemsControl ItemsSource="{Binding Pagination.PageNumbers}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <Button Content="{Binding PageNumber}"
                                                    Command="{Binding DataContext.Pagination.GoToPageCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding PageNumber}">

                                                    <Button.Style>
                                                        <Style TargetType="{x:Type Button}"
                                                            BasedOn="{StaticResource PaginationButtonStyle}">

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}"
                                                                    Value="True">
                                                                    <Setter Property="Background"
                                                                        Value="#FF2563EB"/>
                                                                    <Setter Property="Foreground"
                                                                        Value="White"/>
                                                                    <Setter Property="BorderBrush"
                                                                        Value="#FF1D4ED8"/>
                                                                    <Setter Property="FontWeight"
                                                                        Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Content="下一页"
                                        MinWidth="70"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding Pagination.NextPageCommand}"/>

                                    <Button Content="尾页"
                                        MinWidth="60"
                                        Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding Pagination.LastPageCommand}"/>
                                </StackPanel>

                                <!-- 右侧页码信息 -->
                                <TextBlock Grid.Column="1"
                                    Margin="16,0,8,0"
                                    FontSize="13"
                                    Foreground="#FF6B7280"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">

                                    <Run Text="第 "/>

                                    <Run Text="{Binding Pagination.CurrentPage}"
                                        FontWeight="SemiBold"
                                        Foreground="#FF2563EB"/>

                                    <Run Text=" 页 / 共 "/>

                                    <Run Text="{Binding Pagination.TotalPages}"
                                        FontWeight="SemiBold"
                                        Foreground="#FF111827"/>

                                    <Run Text=" 页"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </HeaderedContentControl>
            </Grid>
        </UserControl>
